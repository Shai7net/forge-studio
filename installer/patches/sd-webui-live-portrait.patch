@@ -0,0 +1,59 @@
+# coding: utf-8
+
+import os.path as osp
+from typing import Tuple
+
+import numpy as np
+
+_SAM_PREDICTOR = None
+_SAM_MODEL_PATH = None
+_SAM_DEVICE = None
+
+
+def _infer_model_type(model_path: str) -> str:
+    name = osp.basename(model_path).lower()
+    if "vit_h" in name:
+        return "vit_h"
+    if "vit_l" in name:
+        return "vit_l"
+    return "vit_b"
+
+
+def get_sam_predictor(model_path: str, device: str):
+    global _SAM_PREDICTOR, _SAM_MODEL_PATH, _SAM_DEVICE
+    if _SAM_PREDICTOR is not None and _SAM_MODEL_PATH == model_path and _SAM_DEVICE == device:
+        return _SAM_PREDICTOR
+
+    from segment_anything import sam_model_registry, SamPredictor
+    model_type = _infer_model_type(model_path)
+    sam = sam_model_registry[model_type](checkpoint=model_path)
+    sam.to(device=device)
+    _SAM_PREDICTOR = SamPredictor(sam)
+    _SAM_MODEL_PATH = model_path
+    _SAM_DEVICE = device
+    return _SAM_PREDICTOR
+
+
+def sam_bbox_from_point(image_rgb: np.ndarray, point_xy: Tuple[int, int], model_path: str, device: str):
+    if not osp.exists(model_path):
+        raise FileNotFoundError(f"SAM checkpoint not found: {model_path}")
+
+    predictor = get_sam_predictor(model_path, device=device)
+    predictor.set_image(image_rgb)
+    point_coords = np.array([[point_xy[0], point_xy[1]]], dtype=np.float32)
+    point_labels = np.array([1], dtype=np.int32)
+    masks, scores, _ = predictor.predict(
+        point_coords=point_coords,
+        point_labels=point_labels,
+        multimask_output=True
+    )
+    if masks is None or len(masks) == 0:
+        return None
+    best_idx = int(np.argmax(scores))
+    mask = masks[best_idx]
+    ys, xs = np.where(mask)
+    if len(xs) == 0 or len(ys) == 0:
+        return None
+    x1, x2 = int(xs.min()), int(xs.max())
+    y1, y2 = int(ys.min()), int(ys.max())
+    return x1, y1, x2, y2
