+def prepare_frame_for_face_detection(frame):
+    """
+    Prepare frame for face detection by handling aspect ratios.
+    For non-square videos (e.g., 9:16), pad to square to improve face detection.
+    """
+    h, w = frame.shape[:2]
+    if h == w:
+        return frame, (0, 0)  # Already square, no offset needed
+    
+    max_dim = max(h, w)
+    
+    # Limit to maximum size to avoid memory issues
+    MAX_DIM = 2048
+    if max_dim > MAX_DIM:
+        scale_factor = MAX_DIM / max_dim
+        h_scaled = int(h * scale_factor)
+        w_scaled = int(w * scale_factor)
+        frame_resized = cv2.resize(frame, (w_scaled, h_scaled), interpolation=cv2.INTER_AREA)
+        max_dim = max(h_scaled, w_scaled)
+    else:
+        frame_resized = frame
+    
+    # Create a square canvas
+    canvas = np.zeros((max_dim, max_dim, 3), dtype=frame_resized.dtype)
+    
+    # Center the frame on the canvas
+    h_resized, w_resized = frame_resized.shape[:2]
+    y_offset = (max_dim - h_resized) // 2
+    x_offset = (max_dim - w_resized) // 2
+    canvas[y_offset:y_offset+h_resized, x_offset:x_offset+w_resized] = frame_resized
+    
+    return canvas, (x_offset, y_offset)
+
+def restore_landmarks_from_padded_frame(lmk, offset, original_shape):
+    """
+    Restore landmarks to original coordinate system after padding.
+    """
+    if offset is None or (isinstance(offset, tuple) and offset == (0, 0)):
+        return lmk
+    
+    x_offset, y_offset = offset
+    h_orig, w_orig = original_shape[:2]
+    
+    # Adjust landmarks back to original coordinates
+    lmk_restored = lmk.copy()
+    lmk_restored[:, 0] -= x_offset
+    lmk_restored[:, 1] -= y_offset
+    
+    # Clip to valid range
+    lmk_restored[:, 0] = np.clip(lmk_restored[:, 0], 0, w_orig - 1)
+    lmk_restored[:, 1] = np.clip(lmk_restored[:, 1], 0, h_orig - 1)
+    
+    return lmk_restored
+
