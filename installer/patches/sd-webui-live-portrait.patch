+# coding: utf-8
+
+import os
+import sys
+from typing import List, Tuple
+
+import numpy as np
+
+
+def _parse_angles(angles_str: str) -> List[int]:
+    if not angles_str:
+        return [0]
+    parts = [p.strip() for p in angles_str.split(",") if p.strip() != ""]
+    angles = []
+    for p in parts:
+        try:
+            angles.append(int(p))
+        except Exception:
+            continue
+    return angles if angles else [0]
+
+
+def _ensure_facefusion(facefusion_root: str):
+    if not facefusion_root or not os.path.isdir(facefusion_root):
+        raise FileNotFoundError(f"FaceFusion root not found: {facefusion_root}")
+    if facefusion_root not in sys.path:
+        sys.path.insert(0, facefusion_root)
+    import facefusion.state_manager as state_manager
+    import facefusion.face_detector as face_detector
+    import facefusion.execution as execution
+    import facefusion.choices as choices
+    return state_manager, face_detector, execution, choices
+
+
+def detect_facefusion(
+    frame_bgr: np.ndarray,
+    facefusion_root: str,
+    detector_model: str,
+    detector_size: str,
+    detector_angles: str,
+    detector_score: float,
+    face_index: int,
+    direction: str,
+    device_id: int = 0
+) -> Tuple[np.ndarray | None, np.ndarray | None]:
+    state_manager, face_detector, execution, choices = _ensure_facefusion(facefusion_root)
+
+    state_manager.init_item("execution_device_id", str(device_id))
+    available_providers = execution.get_available_execution_providers()
+    if "cuda" in available_providers:
+        state_manager.init_item("execution_providers", ["cuda", "cpu"])
+    else:
+        state_manager.init_item("execution_providers", ["cpu"])
+    state_manager.init_item("download_providers", choices.download_providers)
+    state_manager.init_item("download_scope", "full")
+    state_manager.init_item("log_level", "warn")
+
+    state_manager.init_item("face_detector_model", detector_model)
+    state_manager.init_item("face_detector_size", detector_size)
+    state_manager.init_item("face_detector_angles", _parse_angles(detector_angles))
+    state_manager.init_item("face_detector_score", float(detector_score))
+
+    try:
+        face_detector.pre_check()
+    except Exception:
+        # If pre_check fails, continue and let detection try anyway.
+        pass
+
+    bboxes, scores, lmk5 = face_detector.detect_faces(frame_bgr)
+    if not bboxes:
+        return None, None
+
+    bboxes = np.array(bboxes)
+    scores = np.array(scores)
+    lmk5 = np.array(lmk5)
+
+    # order faces
+    areas = (bboxes[:, 2] - bboxes[:, 0]) * (bboxes[:, 3] - bboxes[:, 1])
+    if direction == "large-small":
+        order = np.argsort(-areas)
+    else:
+        order = np.argsort(areas)
+
+    if face_index >= len(order):
+        return None, None
+
+    idx = order[face_index]
+    return lmk5[idx], bboxes[idx]
