+    def _anchor_preview_from_point(image_rgb, use_sam: bool, evt: gr.SelectData):
+        x, y = _set_anchor(evt)
+        if image_rgb is None or x < 0 or y < 0:
+            return x, y, None
+
+        h, w = image_rgb.shape[:2]
+        roi_x1 = roi_y1 = roi_x2 = roi_y2 = None
+        crop_cfg = get_crop_config()
+
+        if use_sam:
+            try:
+                device = "cuda" if (torch.cuda.is_available() and not crop_cfg.flag_force_cpu) else "cpu"
+                bbox = sam_bbox_from_point(image_rgb, (x, y), crop_cfg.sam_model_path, device=device)
+                if bbox is not None:
+                    bx1, by1, bx2, by2 = bbox
+                    pad_ratio = float(getattr(crop_cfg, "sam_pad_ratio", 0.2))
+                    pad = int(max(bx2 - bx1, by2 - by1) * pad_ratio)
+                    roi_x1 = max(0, bx1 - pad)
+                    roi_y1 = max(0, by1 - pad)
+                    roi_x2 = min(w, bx2 + pad)
+                    roi_y2 = min(h, by2 + pad)
+            except Exception:
+                roi_x1 = roi_y1 = roi_x2 = roi_y2 = None
+
+        if roi_x1 is None:
+            box_ratio = float(getattr(crop_cfg, "anchor_box_ratio", 0.45))
+            box_size = max(64, int(min(h, w) * box_ratio))
+            half = box_size // 2
+            roi_x1 = max(0, x - half)
+            roi_y1 = max(0, y - half)
+            roi_x2 = min(w, x + half)
+            roi_y2 = min(h, y + half)
+
+        roi = image_rgb[roi_y1:roi_y2, roi_x1:roi_x2]
+        if roi.size == 0:
+            return x, y, None
+
+        return x, y, roi
