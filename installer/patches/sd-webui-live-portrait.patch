+# coding: utf-8
+
+"""
+Advanced aspect ratio preservation system
+Maintains original video dimensions throughout the entire pipeline
+"""
+
+import numpy as np
+from dataclasses import dataclass
+from typing import Tuple, Optional
+
+DTYPE = np.float32
+
+
+@dataclass
+class AspectRatioConfig:
+    """Configuration for aspect ratio preservation"""
+    preserve_ratio: bool = True  # Always preserve original ratio
+    min_dimension: int = 256  # Minimum output dimension
+    max_dimension: int = 1024  # Maximum output dimension
+    target_short_side: int = 512  # Target size for shorter side
+    padding_mode: str = 'constant'  # How to handle padding
+    interpolation_quality: int = 3  # 0-3, higher = better quality
+
+
+class AspectRatioPreserver:
+    """
+    Elegant and sophisticated system to preserve aspect ratio throughout pipeline
+    """
+    
+    def __init__(self, config: Optional[AspectRatioConfig] = None):
+        self.config = config or AspectRatioConfig()
+        self.original_shape: Optional[Tuple[int, int]] = None
+        self.processing_shape: Optional[Tuple[int, int]] = None
+        self.output_shape: Optional[Tuple[int, int]] = None
+        self.scale_factors: Optional[Tuple[float, float]] = None
+    
+    def analyze_input(self, img_shape: Tuple[int, int]) -> dict:
+        """
+        Analyze input image and determine optimal processing dimensions
+        
+        Args:
+            img_shape: (height, width) of input image
+            
+        Returns:
+            Dictionary with analysis results
+        """
+        h, w = img_shape
+        self.original_shape = (h, w)
+        
+        aspect_ratio = h / w if w > 0 else 1.0
+        is_square = abs(aspect_ratio - 1.0) < 0.05
+        
+        # Calculate optimal processing dimensions
+        if is_square:
+            # For square images, use standard size
+            proc_h = proc_w = self.config.target_short_side
+        else:
+            # For rectangular, maintain ratio with target on shorter side
+            if h < w:  # Landscape
+                proc_h = self.config.target_short_side
+                proc_w = int(self.config.target_short_side / aspect_ratio)
+            else:  # Portrait
+                proc_w = self.config.target_short_side
+                proc_h = int(self.config.target_short_side * aspect_ratio)
+        
+        # Ensure dimensions are reasonable
+        proc_w = max(self.config.min_dimension, min(proc_w, self.config.max_dimension))
+        proc_h = max(self.config.min_dimension, min(proc_h, self.config.max_dimension))
+        
+        # Make divisible by 16 for neural network compatibility
+        proc_h = (proc_h // 16) * 16
+        proc_w = (proc_w // 16) * 16
+        
+        self.processing_shape = (proc_h, proc_w)
+        self.output_shape = (proc_h, proc_w)
+        
+        # Calculate scale factors for transformations
+        scale_h = proc_h / h if h > 0 else 1.0
+        scale_w = proc_w / w if w > 0 else 1.0
+        self.scale_factors = (scale_h, scale_w)
+        
+        return {
+            'original_shape': self.original_shape,
+            'processing_shape': self.processing_shape,
+            'aspect_ratio': aspect_ratio,
+            'is_square': is_square,
+            'scale_factors': self.scale_factors,
+        }
+    
+    def get_processing_dimensions(self, target_size: int = 512) -> Tuple[int, int]:
+        """
+        Get optimal processing dimensions while preserving aspect ratio
+        
+        Args:
+            target_size: Target size for the shorter side
+            
+        Returns:
+            (height, width) tuple for processing
+        """
+        if self.original_shape is None:
+            return (target_size, target_size)
+        
+        h, w = self.original_shape
+        aspect_ratio = h / w if w > 0 else 1.0
+        
+        if abs(aspect_ratio - 1.0) < 0.05:  # Nearly square
+            return (target_size, target_size)
+        elif aspect_ratio > 1.0:  # Portrait
+            proc_h = target_size
+            proc_w = int(target_size / aspect_ratio)
+        else:  # Landscape
+            proc_w = target_size
+            proc_h = int(target_size * aspect_ratio)
+        
+        # Ensure divisibility by 16 for neural networks
+        proc_h = max(256, (proc_h // 16) * 16)
+        proc_w = max(256, (proc_w // 16) * 16)
+        
+        return (proc_h, proc_w)
+    
+    def get_inverse_scale_factors(self) -> Tuple[float, float]:
+        """Get inverse scale factors for reversing transformations"""
+        if self.scale_factors is None:
+            return (1.0, 1.0)
+        
+        scale_h, scale_w = self.scale_factors
+        inv_scale_h = 1.0 / scale_h if scale_h > 0 else 1.0
+        inv_scale_w = 1.0 / scale_w if scale_w > 0 else 1.0
+        
+        return (inv_scale_h, inv_scale_w)
+    
+    def scale_landmarks(self, landmarks: np.ndarray, 
+                       forward: bool = True) -> np.ndarray:
+        """
+        Scale landmarks while preserving precision
+        
+        Args:
+            landmarks: Nx2 array of (x, y) coordinates
+            forward: If True, scale from original to processing. 
+                    If False, scale from processing back to original.
+            
+        Returns:
+            Scaled landmarks
+        """
+        if self.scale_factors is None:
+            return landmarks.copy()
+        
+        landmarks_scaled = landmarks.copy().astype(DTYPE)
+        
+        if forward:
+            scale_h, scale_w = self.scale_factors
+        else:
+            scale_h, scale_w = self.get_inverse_scale_factors()
+        
+        # Apply scaling (x is width, y is height)
+        landmarks_scaled[:, 0] *= scale_w  # x coordinate
+        landmarks_scaled[:, 1] *= scale_h  # y coordinate
+        
+        return landmarks_scaled
+    
+    def scale_bbox(self, bbox: np.ndarray, 
+                   forward: bool = True) -> np.ndarray:
+        """
+        Scale bounding box while preserving aspect ratio
+        
+        Args:
+            bbox: Bounding box coordinates
+            forward: If True, scale from original to processing.
+                    If False, scale from processing back to original.
+            
+        Returns:
+            Scaled bounding box
+        """
+        if self.scale_factors is None:
+            return bbox.copy()
+        
+        bbox_scaled = bbox.copy().astype(DTYPE)
+        
+        if forward:
+            scale_h, scale_w = self.scale_factors
+        else:
+            scale_h, scale_w = self.get_inverse_scale_factors()
+        
+        # Apply scaling to each dimension
+        bbox_scaled[:, 0] *= scale_w  # x coordinates
+        bbox_scaled[:, 1] *= scale_h  # y coordinates
+        
+        return bbox_scaled
+    
+    def create_transformation_matrix(self, 
+                                     source_bbox: np.ndarray,
+                                     target_size: int = 512) -> np.ndarray:
+        """
+        Create affine transformation matrix that preserves aspect ratio
+        
+        Args:
+            source_bbox: Source bounding box
+            target_size: Target size for processing
+            
+        Returns:
+            2x3 affine transformation matrix
+        """
+        # Get processing dimensions
+        proc_h, proc_w = self.get_processing_dimensions(target_size)
+        
+        # Calculate bounding box center and size
+        x1, y1, x2, y2 = source_bbox
+        bbox_w = x2 - x1
+        bbox_h = y2 - y1
+        center_x = (x1 + x2) / 2.0
+        center_y = (y1 + y2) / 2.0
+        
+        # Scale to maintain aspect ratio
+        scale = min(proc_w / bbox_w, proc_h / bbox_h) if bbox_w > 0 and bbox_h > 0 else 1.0
+        
+        # Create transformation matrix
+        M = np.array([
+            [scale, 0, proc_w/2 - scale * center_x],
+            [0, scale, proc_h/2 - scale * center_y]
+        ], dtype=DTYPE)
+        
+        return M
+    
+    def get_summary(self) -> str:
+        """Get a summary of aspect ratio preservation settings"""
+        if self.original_shape is None:
+            return "No analysis performed yet"
+        
+        h_orig, w_orig = self.original_shape
+        h_proc, w_proc = self.processing_shape or (0, 0)
+        aspect_orig = h_orig / w_orig if w_orig > 0 else 1.0
+        aspect_proc = h_proc / w_proc if w_proc > 0 else 1.0
+        
+        summary = f"""
+╔═══════════════════════════════════════════╗
+║   Aspect Ratio Preservation Summary       ║
+╠═══════════════════════════════════════════╣
+║ Original Shape:    {h_orig:4d}x{w_orig:4d}                 ║
+║ Processing Shape:  {h_proc:4d}x{w_proc:4d}                 ║
+║ Original Ratio:    {aspect_orig:.3f}:1                  ║
+║ Processing Ratio:  {aspect_proc:.3f}:1                  ║
+║ Ratio Preserved:   {"✅ YES" if abs(aspect_orig - aspect_proc) < 0.01 else "⚠️  NO"}                   ║
+║ Scale Factors:     {self.scale_factors[0]:.4f}, {self.scale_factors[1]:.4f}            ║
+╚═══════════════════════════════════════════╝
+"""
+        return summary
+
+
+# Global instance for pipeline-wide aspect ratio management
+_global_ar_preserver = None
+
+
+def get_aspect_ratio_preserver(config: Optional[AspectRatioConfig] = None) -> AspectRatioPreserver:
+    """Get or create global aspect ratio preserver"""
+    global _global_ar_preserver
+    if _global_ar_preserver is None:
+        _global_ar_preserver = AspectRatioPreserver(config)
+    return _global_ar_preserver
+
+
+def reset_aspect_ratio_preserver():
+    """Reset global aspect ratio preserver"""
+    global _global_ar_preserver
+    _global_ar_preserver = None
