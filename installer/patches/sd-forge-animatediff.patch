+def cache_preprocessed(p, cn_unit, frames_dir: str, limit=None):
+    """
+    Run a ControlNet unit's preprocessor (OpenPose, depth...) over the video frames once and keep the maps
+    next to the frames. Returns the folder of maps, to be used with preprocessor None, or None when the
+    preprocessor does not produce images (IP-Adapter and the like) or fails.
+    """
+    import cv2
+    from lib_controlnet import global_state, external_code
+    from lib_controlnet.utils import align_dim_latent, judge_image_type
+    from modules_forge.forge_util import HWC3
+
+    module = str(getattr(cn_unit, "module", "None") or "None")
+    if module.lower() == "none":
+        return None
+    preprocessor = global_state.get_preprocessor(module)
+    if preprocessor is None:
+        return None
+    body_only = module == "dw_openpose_full" and getattr(cn_unit, "dance_body_only", False)
+    if body_only:
+        # objects that dance: the body skeleton only; face and finger points pull the picture towards people
+        from legacy_preprocessors.preprocessor import g_openpose_model
+
+        def preprocessor(input_image, input_mask=None, resolution=512, slider_1=None, slider_2=None):
+            result, _ = g_openpose_model.run_model(img=input_image, include_body=True, include_hand=False,
+                                                   include_face=False, use_dw_pose=True, res=resolution)
+            return result
+        preprocessor.unload_function = g_openpose_model.unload
+        module = "dw_openpose_body"
+
+    frames = list_frames(frames_dir)
+    if limit:
+        frames = frames[:limit]
+    h, w = align_dim_latent(p.height), align_dim_latent(p.width)
+    resize_mode = external_code.resize_mode_from_value(cn_unit.resize_mode)
+
+    def resolution_for(img):
+        if cn_unit.pixel_perfect:
+            return external_code.pixel_perfect_resolution(img, target_H=h, target_W=w, resize_mode=resize_mode)
+        return cn_unit.processor_res
+
+    first = HWC3(np.ascontiguousarray(cv2.imread(frames[0])[:, :, ::-1]))
+    res = resolution_for(first)
+    safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in module)
+    out = Path(frames_dir).parent / f"cn-{safe}-r{res}-a{cn_unit.threshold_a:g}-b{cn_unit.threshold_b:g}"
+    todo = [f for f in frames if not (out / f"{Path(f).stem}.png").exists()]
+    if todo:
+        out.mkdir(parents=True, exist_ok=True)
+        logger.info(f"Preparing {module} maps once for {len(todo)} frames (next renders of this video reuse them)...")
+        from tqdm import tqdm
+        # Forge's legacy preprocessors unload their model after every image, so a frame loop reloads it
+        # every time (OpenPose: 3 models per frame). Keep it loaded for the loop and unload once at the end.
+        unload = getattr(preprocessor, "unload_function", None)
+        if unload is not None:
+            preprocessor.unload_function = None
+        try:
+            for frame in tqdm(todo):
+                img = HWC3(np.ascontiguousarray(cv2.imread(frame)[:, :, ::-1]))
+                try:
+                    result = preprocessor(input_image=img, input_mask=None, resolution=resolution_for(img),
+                                          slider_1=cn_unit.threshold_a, slider_2=cn_unit.threshold_b)
+                except Exception as e:
+                    logger.warning(f"Could not cache {module} maps, ControlNet runs it as usual: {e}")
+                    return None
+                if not judge_image_type(result):
+                    return None
+                Image.fromarray(HWC3(result.astype(np.uint8))).save(out / f"{Path(frame).stem}.png")
+        finally:
+            if unload is not None:
+                preprocessor.unload_function = unload
+                unload()
+    else:
+        logger.info(f"Using cached {module} maps: {out}")
+    return _steady_poses(out, frames) if body_only else str(out)
+
+
+def _steady_poses(folder: Path, frames: list) -> str:
+    """
+    On dark or blurred frames the pose detector loses a dancer for a moment, and the figure drawn from it
+    blinks. A frame with well under the usual amount of skeleton takes the pose map of the nearest full frame.
+    """
+    import shutil
+    names = [f"{Path(frame).stem}.png" for frame in frames]
+    out = folder.with_name(folder.name + "-steady")
+    if (out / ".done").exists() and all((out / name).exists() for name in names):
+        return str(out)
+    out.mkdir(exist_ok=True)
+    ink = []
+    for name in names:
+        with Image.open(folder / name) as im:
+            ink.append((np.asarray(im.convert("L")) > 16).mean())
+    ink = np.array(ink)
+    usual = np.array([np.median(ink[max(0, t - 3):t + 4]) for t in range(len(ink))])
+    weak = set(np.flatnonzero(ink < 0.6 * usual).tolist())
+    for t, name in enumerate(names):
+        full = [s for s in sorted(range(len(names)), key=lambda s: abs(s - t)) if s not in weak] if t in weak else [t]
+        shutil.copyfile(folder / names[full[0] if full else t], out / name)
+    (out / ".done").touch()
+    logger.info(f"Poses: {len(weak)} of {len(names)} frames lost a dancer and take the pose next to them.")
+    return str(out)
+
+
+# ---------------------------------------------------------------------------------------------------------
+# 💃 Dance video: one switch sets up AnimateDiff and ControlNet from a dance video and reference pictures
+# ---------------------------------------------------------------------------------------------------------
+
+DANCE_FPS_CHOICES = ["8 (quick test)", "12", "24 (smooth, FILM)"]
+DANCE_ONE_PASS_MAX = 240     # frames drawn in one pass (20 s); longer videos go in parts
+DANCE_PART_FRAMES = 120
+DANCE_PART_OVERLAP = 16
+SECONDS_PER_FRAME = 6.0      # first render at 408x720 on his 3070 Laptop: prep, drawing, FILM, encode (measured 2026-09-30)
+# objects that dance: without these the checkpoint and the pose turn the figures into people
+DANCE_FINAL_SIZES = ["As drawn", "x1.5", "x2"]
+# for the final size; the first one installed is the default. RTX Video keeps the picture as drawn and takes
+# about 5 ms a frame, R-ESRGAN redraws it with harder edges in about 0.4 s a frame (408x728 x2, RTX 3070 Laptop)
+DANCE_UPSCALERS = ("RTX Video Super Resolution", "R-ESRGAN 4x+", "ESRGAN_4x", "Lanczos")
+NO_PEOPLE_WORDS = ("person", "people", "face", "eyes", "skin", "hair", "clothes", "doll", "mannequin")
+
+
+def dance_upscalers() -> list:
+    """The upscalers for the final size, the preferred ones first."""
+    names = [u.name for u in shared.sd_upscalers if u.name != "None"]
+    return [n for n in DANCE_UPSCALERS if n in names] + [n for n in names if n not in DANCE_UPSCALERS]
+
+
+def draw_plan(choice, source_fps: float = 0) -> tuple:
+    """
+    Frames drawn per second of video and the FILM factor, for the panel's frames-per-second choice.
+    A source video with fewer frames a second (an 8 FPS export) is drawn at its own rate, since drawing more
+    would only repeat frames; the smooth choice then lets FILM fill up to 24.
+    """
+    text = str(choice)
+    if text.startswith("8"):
+        fps, film = 8, 1
+    elif text.startswith("12"):
+        fps, film = 12, 1
+    else:
+        fps, film = 12, 2    # 24 FPS: 12 are drawn and FILM doubles them, in half the drawing time
+    if 0 < source_fps < fps - 0.5:
+        film = max(2, round(fps * film / source_fps)) if film > 1 else 1
+        fps = source_fps
+    return fps, film
+
+
+def _file_path(value):
+    """A path from a Gradio file/video value, a path string or a base64 data URI (API)."""
+    if value is None:
+        return None
+    if isinstance(value, dict):
+        value = value.get("name") or value.get("data")
+    value = getattr(value, "name", value)
+    if not isinstance(value, str) or not value.strip():
+        return None
+    value = value.strip().strip('"')
+    if value.startswith("data:") or len(value) > 1024:
+        import base64
+        import tempfile
+        payload = value.partition(",")[2] if value.startswith("data:") else value
+        with tempfile.NamedTemporaryFile(delete=False, suffix=".png", prefix="dance_ref_") as f:
+            f.write(base64.b64decode(payload))
+            return f.name
+    return value if os.path.isfile(value) else None
+
+
+def load_pictures(values, limit: int = 4):
+    if values is None:
+        return []
+    if not isinstance(values, (list, tuple)):
+        values = [values]
+    pictures = []
+    for value in values:
+        path = _file_path(value)
+        if not path:
+            continue
+        try:
+            with Image.open(path) as im:
+                pictures.append(im.convert("RGB"))
+        except Exception as e:
+            logger.warning(f"Could not open reference picture {path}: {e}")
+    return pictures[:limit]
+
+
+def reference_image(pictures, tile: int = 512):
+    """
+    IP-Adapter in Forge takes one picture per unit, so several pictures are tiled into one square
+    (it crops to a square anyway): 2 -> a b / b a, 3 -> a b / c a, 4 -> a b / c d.
+    """
+    if not pictures:
+        return None
+
+    def square(im):
+        side = min(im.size)
+        left, top = (im.width - side) // 2, (im.height - side) // 2
+        return im.crop((left, top, left + side, top + side)).resize((tile, tile), Image.LANCZOS)
+
+    tiles = [square(im) for im in pictures]
+    if len(tiles) == 1:
+        return np.asarray(tiles[0])
+    a, b = tiles[0], tiles[1]
+    c = tiles[2] if len(tiles) > 2 else b
+    d = tiles[3] if len(tiles) > 3 else a
+    grid = Image.new("RGB", (tile * 2, tile * 2))
+    for im, xy in ((a, (0, 0)), (b, (tile, 0)), (c, (0, tile)), (d, (tile, tile))):
+        grid.paste(im, xy)
+    return np.asarray(grid)
+
+
+def video_info(video: str):
+    import cv2
+    cap = cv2.VideoCapture(video)
+    fps = cap.get(cv2.CAP_PROP_FPS) or 0
+    count = cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0
+    width, height = cap.get(cv2.CAP_PROP_FRAME_WIDTH), cap.get(cv2.CAP_PROP_FRAME_HEIGHT)
+    cap.release()
+    seconds = count / fps if fps > 0 else 0
+    return seconds, fps, int(width), int(height)
+
+
+def size_like_video(width: int, height: int, video_w: int, video_h: int):
+    """Keep the chosen number of pixels, take the video's shape (multiples of 8)."""
+    if not video_w or not video_h:
+        return width, height
+    area, ratio = width * height, video_w / video_h
+    new_w = int(round((area * ratio) ** 0.5 / 8)) * 8
+    new_h = int(round(new_w / ratio / 8)) * 8
+    return max(64, new_w), max(64, new_h)
+
+
+def plan_text(video: str, width, height, fps_choice=DANCE_FPS_CHOICES[2], final: str = "As drawn",
+              upscaler: str = "") -> str:
+    """What the dance video will do, shown under the upload."""
+    seconds, fps, video_w, video_h = video_info(video)
+    if seconds <= 0:
+        return "Could not read this video."
+    draw_fps, film = draw_plan(fps_choice, fps)
+    frames = int(round(seconds * draw_fps))
+    parts = f"{-(-frames // DANCE_PART_FRAMES)} × {DANCE_PART_FRAMES}" if frames > DANCE_ONE_PASS_MAX else "1 ×"
+    w, h = size_like_video(int(width or 408), int(height or 720), video_w, video_h)
+    minutes = frames * SECONDS_PER_FRAME * (w * h) / (408 * 720) / 60
+    out_fps = draw_fps * film
+    scale = {"x1.5": 1.5, "x2": 2.0}.get(str(final), 1.0)
+    size = f"{w}×{h}"
+    if scale > 1:
+        size += f" → {int(w * scale) // 2 * 2}×{int(h * scale) // 2 * 2}"
+        per_frame = 0.02 if "RTX" in str(upscaler) else 0.38      # seconds at x2, measured: RTX Video, R-ESRGAN
+        minutes += frames * film * per_frame * scale * scale / 4 / 60
+    # numbers and symbols only, so the line reads the same in the Hebrew UI
+    return (f"🎬 {seconds:.1f}s · {video_w}×{video_h} · {fps:.0f} FPS  →  🖼 {frames} · {size} · {parts}  →  "
+            f"🎞 {out_fps:g} FPS + 🎵  ·  ⏱ ~{max(1, round(minutes))} min")
+
+
+def _find_cn_model(match, prefer=()):
+    from lib_controlnet import global_state
+    names = [n for n in global_state.get_all_controlnet_names() if n and n != "None"]
+    candidates = [n for n in names if match(n.lower().replace("-", "").replace("_", ""))]
+    for word in prefer:
+        for name in candidates:
+            if word in name.lower():
+                return name
+    return candidates[0] if candidates else None
+
+
+def dance_units(params):
+    """The ControlNet units of a dance video, with the models found in this Forge."""
+    from lib_controlnet import global_state
+    from lib_controlnet.external_code import ControlNetUnit
+
+    units, missing = [], []
+    qr = _find_cn_model(lambda n: "qrcode" in n or "monster" in n, prefer=("v20", "v2"))
+    if qr:
+        units.append(("shape", ControlNetUnit(enabled=True, module="None", model=qr, weight=float(params.dance_w_shape),
+                                              guidance_end=0.9, resize_mode="Crop and Resize")))
+    else:
+        missing.append("QR Code Monster")
+    if float(params.dance_w_pose) > 0:
+        pose = _find_cn_model(lambda n: "openpose" in n and "xl" not in n, prefer=("control_v11p",))
+        module = "dw_openpose_full" if global_state.get_preprocessor("dw_openpose_full") else "openpose_full"
+        if pose:
+            unit = ControlNetUnit(enabled=True, module=module, model=pose, weight=float(params.dance_w_pose),
+                                  pixel_perfect=True, resize_mode="Crop and Resize")
+            unit.dance_body_only = True
+            units.append(("pose", unit))
+        else:
+            missing.append("OpenPose")
+    ip = _find_cn_model(lambda n: "ipadapter" in n and "plus" in n and "sd15" in n and "face" not in n,
+                        prefer=("ip-adapter-plus_sd15",))
+    for kind, pictures, weight in (("characters", params.dance_characters, params.dance_w_character),
+                                   ("background", params.dance_background, params.dance_w_background)):
+        image = reference_image(load_pictures(pictures))
+        if image is None or float(weight) <= 0:
+            continue
+        if not ip:
+            missing.append("IP-Adapter plus SD1.5")
+            break
+        units.append((kind, ControlNetUnit(enabled=True, module="CLIP-ViT-H (IPAdapter)", model=ip,
+                                           weight=float(weight),
+                                           image={"image": image, "mask": np.zeros_like(image)},
+                                           resize_mode="Crop and Resize")))
+    return units, missing
+
+
+def install_units(p, units):
+    """Put the dance units into ControlNet's slots (the user's own units are switched off for this run)."""
+    from lib_controlnet.external_code import ControlNetUnit
+    for script in p.scripts.alwayson_scripts:
+        if script.title().lower() != "controlnet":
+            continue
+        slots = script.args_to - script.args_from
+        if len(units) > slots:
+            dropped = [name for name, _ in units[slots:]]
+            logger.warning(f"Only {slots} ControlNet units are available, so the {', '.join(dropped)} unit(s) are "
+                           f"left out. Settings → ControlNet → Multi-ControlNet unit number: set it to 4.")
+            units = units[:slots]
+        chosen = [unit for _, unit in units] + [ControlNetUnit(enabled=False) for _ in range(slots - len(units))]
+        p.script_args = list(p.script_args)
+        p.script_args[script.args_from:script.args_to] = chosen
+        return [name for name, _ in units]
+    raise RuntimeError("ControlNet is not loaded, so a dance video cannot be made.")
+
+
+def _lcm_lora_tag():
+    try:
+        import networks
+        for name in networks.available_networks:
+            low = name.lower()
+            if "lcm" in low and "xl" not in low:
+                return f"<lora:{name}:1>"
+    except Exception:
+        pass
+    return None
+
+
+def apply_dance_mode(params, p):
+    """Everything the dance video needs, set right before AnimateDiff starts."""
+    video = _file_path(params.dance_video)
+    if not video:
+        raise ValueError("💃 Dance video: upload the dance video first (or switch the dance video off).")
+    seconds, source_fps, video_w, video_h = video_info(video)
+
+    params.enable = True
+    if params.dance_model:
+        params.model = params.dance_model
+    params.video_source, params.video_path = video, ""
+    params.dance_sync = params.dance_mask = True
+    params.closed_loop, params.batch_size, params.stride, params.overlap = "N", 16, 1, 4
+    params.video_length = 0
+    draw_fps, film = draw_plan(params.dance_fps, source_fps)
+    params.fps, params.interp = int(round(draw_fps * film)), "FILM" if film > 1 else "Off"
+    if film > 1:
+        params.interp_x = film
+    params.format = ["MP4"]
+    if not params.segment_length and seconds * draw_fps > DANCE_ONE_PASS_MAX:
+        params.segment_length, params.segment_overlap = DANCE_PART_FRAMES, DANCE_PART_OVERLAP
+    final = {"x1.5": 1.5, "x2": 2.0}.get(str(params.dance_final_size), 1.0)
+    if final > 1:
+        names = dance_upscalers()
+        chosen = str(getattr(params, "dance_upscaler", "") or "")
+        params.upscaler = chosen if chosen in names else (names[0] if names else "Lanczos")
+        params.upscale_by = final
+    music = _file_path(params.dance_music)
+    if music:
+        params.audio_source, params.audio_path = music, ""
+
+    notes = []
+    if params.dance_match_size:
+        width, height = size_like_video(p.width, p.height, video_w, video_h)
+        if (width, height) != (p.width, p.height):
+            notes.append(f"size {p.width}x{p.height} → {width}x{height} (the video's shape)")
+            p.width, p.height = width, height
+    if params.dance_auto_lcm and "lcm" in str(params.model).lower():
+        from modules import sd_samplers
+        if "LCM" in sd_samplers.all_samplers_map and p.sampler_name != "LCM":
+            notes.append(f"sampler {p.sampler_name} → LCM")
+            p.sampler_name = "LCM"
+        if p.steps > 12:
+            notes.append(f"steps {p.steps} → 8")
+            p.steps = 8
+        if p.cfg_scale > 3:
+            notes.append(f"CFG {p.cfg_scale:g} → 2")
+            p.cfg_scale = 2
+        if isinstance(p.prompt, str) and "lcm" not in p.prompt.lower():
+            tag = _lcm_lora_tag()
+            if tag:
+                p.prompt = f"{p.prompt}, {tag}"
+                notes.append(f"added {tag}")
+
+    if params.dance_no_people:
+        present = str(p.negative_prompt or "").lower()
+        extra = [w for w in NO_PEOPLE_WORDS if w not in present]
+        if extra:
+            p.negative_prompt = ", ".join(x for x in (p.negative_prompt, ", ".join(extra)) if x)
+            notes.append("negative: no people")
+
+    units, missing = dance_units(params)
+    if missing:
+        logger.warning(f"💃 Dance video: no ControlNet model found for {', '.join(missing)}.")
+    used = install_units(p, units)
+    params.dance_unit_names = used
+    logger.info(f"💃 Dance video: {seconds:.1f} s, motion module {params.model}, ControlNet: {', '.join(used)}"
+                + (f"; {'; '.join(notes)}" if notes else ""))
+
+
+# ---------------------------------------------------------------------------------------------------------
+# Regions: every dance unit acts only where it should
+# ---------------------------------------------------------------------------------------------------------
+
+REGION_UNITS = ("characters", "background")
+REGION_GROW = 1      # px at 1/8 size (= 8 px in the picture): the dancers' look reaches just past their edge
+REGION_SOFTEN = 5    # blur kernel at 1/8 size: a soft seam, so the two looks melt into each other
+SHAPE_REACH = 0.06   # the shape unit also acts this far around the dancers (share of the picture's width)
+
+
+def region_masks(raw_dir: str, frames: list, width: int, height: int, grow: int = REGION_GROW):
+    """
