+    def plan_segments(self, p: StableDiffusionProcessing):
+        """
+        A long video is rendered as several AnimateDiff runs of `segment_length` frames (Forge's own batch loop,
+        so the progress bar, Interrupt and memory cleanup work per part). Neighbouring parts share
+        `segment_overlap` frames, start from the same noise there, and are cross-faded when saving.
+        """
+        import re
+        length, total = int(self.segment_length or 0), int(self.video_length)
+        if length <= 0 or total <= length or self.is_i2i_batch or isinstance(p, StableDiffusionProcessingImg2Img):
+            return
+        if isinstance(p.prompt, str) and re.search(r"^\d+:", p.prompt, re.M):
+            logger.warning("Prompt travel numbers frames over the whole video, so this video is rendered in one pass.")
+            return
+        length = max(length, self.batch_size)  # a part holds at least one context window
+        if total <= length:
+            return
+        overlap = max(0, min(int(self.segment_overlap or 0), length // 2))
+        starts, s = [], 0
+        while True:
+            starts.append(min(s, total - length))
+            if s + length >= total:
+                break
+            s += length - overlap
+        if self.closed_loop != 'N':
+            logger.info("Closed loop is set to N for a video rendered in parts.")
+            self.closed_loop = 'N'
