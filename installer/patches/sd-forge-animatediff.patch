+AUDIO_FILE_TYPES = ["audio", "video", ".mp3", ".wav", ".flac", ".ogg", ".opus", ".m4a", ".aac", ".wma", ".aiff",
+                    ".mp4", ".mov", ".mkv", ".webm"]
+AUDIO_MODE_CUT = "Cut the music to the video"
+AUDIO_MODE_LOOP = "Loop the video for the whole music"
+AUDIO_MODES = [AUDIO_MODE_CUT, AUDIO_MODE_LOOP]
+
+
+def resolve_audio_path(audio_source, audio_path=""):
+    """
+    Music for the video: an uploaded file (Gradio temp file, or a path / base64 data URI from the API),
+    else a path typed in the textbox. Returns an existing file path or None.
+    """
+    path = audio_source
+    if isinstance(path, dict):
+        path = path.get("name") or path.get("data")
+    path = getattr(path, "name", path)
+    if not path and audio_path:
+        path = audio_path
+    if not isinstance(path, str) or not path.strip():
+        return None
+    path = path.strip().strip('"').strip("'")
+
+    if path.startswith("data:"):
+        import base64
+        import tempfile
+        header, _, payload = path.partition(",")
+        ext = "." + header.split("/")[-1].split(";")[0] if "/" in header else ".mp3"
+        with tempfile.NamedTemporaryFile(delete=False, suffix=ext, prefix="animatediff_audio_") as f:
+            f.write(base64.b64decode(payload))
+            return f.name
+
+    if not os.path.isfile(path):
+        logger.warning(f"Music file not found, the video is saved without sound: {path}")
+        return None
+    return path
+
+
+def get_audio_duration(path: str):
+    """Length of the audio track in seconds, or None."""
+    try:
+        import av
+        with av.open(path) as container:
+            stream = next((s for s in container.streams if s.type == "audio"), None)
+            if stream is None:
+                return None
+            if stream.duration is not None and stream.time_base is not None:
+                return float(stream.duration * stream.time_base)
+            if container.duration is not None:
+                return container.duration / 1_000_000
+    except Exception as e:
+        logger.warning(f"Could not read the music length of {path}: {e}")
+    return None
+
+
+def add_audio_to_video(video_path: str, audio_path: str, video_seconds: float,
+                       offset: float = 0, mode: str = AUDIO_MODE_CUT, fade_out: bool = True):
+    """
+    Mux the music into an already-saved MP4/WEBM in place. The video stream is copied, not re-encoded.
+    Cut mode: the video length decides. Loop mode: the video repeats until the music ends.
+    """
+    import imageio_ffmpeg
+
+    offset = max(0.0, float(offset or 0))
+    audio_seconds = get_audio_duration(audio_path)
+    if audio_seconds is not None:
+        audio_seconds = max(0.0, audio_seconds - offset)
+        if audio_seconds <= 0:
+            logger.warning(f"Music start ({offset}s) is past the end of the music, the video is saved without sound.")
+            return False
+
+    if mode == AUDIO_MODE_LOOP and audio_seconds:
+        target = audio_seconds
+    else:
+        if mode == AUDIO_MODE_LOOP:
+            logger.warning("Music length unknown, cutting the music to the video instead of looping.")
+            mode = AUDIO_MODE_CUT
+        target = video_seconds  # a shorter song just ends; the video is never cut
+    sound_end = target if audio_seconds is None else min(target, audio_seconds)
+
+    src = Path(video_path)
+    silent = src.with_name(f"{src.stem}.noaudio{src.suffix}")
+    os.replace(src, silent)
+
+    is_webm = src.suffix.lower() == ".webm"
+    cmd = [imageio_ffmpeg.get_ffmpeg_exe(), "-y", "-hide_banner", "-loglevel", "error"]
+    if mode == AUDIO_MODE_LOOP:
+        cmd += ["-stream_loop", "-1"]
+    cmd += ["-i", str(silent)]
+    if offset > 0:
+        cmd += ["-ss", f"{offset:.3f}"]
+    cmd += ["-i", str(audio_path),
+            "-map", "0:v:0", "-map", "1:a:0", "-map_metadata", "0",
+            "-c:v", "copy"]
+    cmd += ["-c:a", "libopus", "-b:a", "160k"] if is_webm else ["-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart"]
+    fade = min(2.0, sound_end / 3)
+    if fade_out and fade > 0.05:
+        cmd += ["-af", f"afade=t=out:st={sound_end - fade:.3f}:d={fade:.3f}"]
+    cmd += ["-t", f"{target:.3f}", str(src)]
+
+    logger.info(f"Adding music to {src.name}: {Path(audio_path).name} from {offset:g}s, {target:.2f}s, {mode}")
+    try:
+        subprocess.run(cmd, check=True, capture_output=True, text=True, encoding="utf-8", errors="replace")
+    except Exception as e:
+        err = getattr(e, "stderr", "") or e
+        logger.error(f"Adding music failed, keeping the video without sound: {err}")
+        if src.exists():
+            src.unlink()
+        os.replace(silent, src)
+        return False
+    silent.unlink(missing_ok=True)
+    return True
