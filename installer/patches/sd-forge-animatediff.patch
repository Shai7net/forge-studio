+    def _join_segments(self, res: Processed, params: AnimateDiffProcess):
+        """Put the parts back on one timeline; where two parts overlap, fade linearly from one to the next."""
+        frames = res.images[res.index_of_first_image:]
+        length = params.video_length
+        parts = [(start, frames[k * length:(k + 1) * length])
+                 for k, start in enumerate(params.segments) if len(frames) >= (k + 1) * length]
+        if len(parts) < len(params.segments):
+            logger.warning(f"Only {len(parts)} of {len(params.segments)} parts were rendered, saving those.")
+        if not parts:
+            return []
+        total = parts[-1][0] + length
+        joined = []
+        for g in range(total):
+            layers = []
+            for k, (start, images) in enumerate(parts):
+                if not start <= g < start + length:
+                    continue
+                weight = 1.0
+                if k > 0:  # fade in over the overlap with the previous part
+                    common = parts[k - 1][0] + length - start
+                    if g - start < common:
+                        weight = min(weight, (g - start + 1) / (common + 1))
+                if k + 1 < len(parts):  # fade out over the overlap with the next part
+                    common = start + length - parts[k + 1][0]
+                    if start + length - g <= common:
+                        weight = min(weight, (start + length - g) / (common + 1))
+                layers.append((weight, images[g - start]))
+            if len(layers) == 1:
+                joined.append(layers[0][1].copy())
+            else:
+                total_weight = sum(w for w, _ in layers)
+                mixed = sum(w * np.asarray(img, dtype=np.float32) for w, img in layers) / total_weight
+                joined.append(Image.fromarray(np.clip(mixed + 0.5, 0, 255).astype(np.uint8)))
+        logger.info(f"Joined {len(parts)} parts into {len(joined)} frames.")
+        return joined
+
+
+    def _upscale(self, params: AnimateDiffProcess, frame_list: list):
+        """Upscale every frame after frame interpolation (FILM at the small size is much faster)."""
+        name = getattr(params, "upscaler", "None")
+        scale = float(getattr(params, "upscale_by", 1) or 1)
+        if not name or name == "None" or scale <= 1:
+            return frame_list
+        upscaler = next((u for u in shared.sd_upscalers if u.name == name), None)
+        if upscaler is None:
+            logger.warning(f"Upscaler {name} not found, the frames keep their size.")
+            return frame_list
+        from tqdm import tqdm
+        import time
+        started = time.time()
+        width, height = frame_list[0].size
+        size = (int(round(width * scale / 8) * 8), int(round(height * scale / 8) * 8))
+        model = self._load_frame_upscaler(upscaler, scale)
+        logger.info(f"Upscaling {len(frame_list)} frames x{scale:g} with {name}"
+                    + (" (model loaded once, whole frames)" if model is not None else ""))
+        result = []
+        try:
+            for frame in tqdm(frame_list):
+                if shared.state.interrupted:
+                    logger.warning("Interrupted while upscaling, the rest of the frames keep their size.")
+                    return frame_list
+                if model is not None:
+                    image = self._upscale_frame(model, frame.convert("RGB"), size)
+                else:
+                    image = upscaler.scaler.upscale(frame.convert("RGB"), scale, upscaler.data_path)
+                if image.size != size:
+                    image = image.resize(size, Image.LANCZOS)
+                result.append(image)
+        finally:
+            del model
+            from modules import devices
+            devices.torch_gc()
+        logger.info(f"Upscaled {len(result)} frames in {time.time() - started:.0f} s.")
+        return result
+
+
+    @staticmethod
+    def _load_frame_upscaler(upscaler, scale: float = 4):
+        """
+        Forge's upscalers load their model from disk, clean the memory and cut the picture into 192 px tiles
+        for every single image: about 3 s a frame. For a video the model is loaded once instead.
+        Returns a Spandrel model, or None to fall back to the upscaler's own per-image path.
+        """
+        scaler = upscaler.scaler
+        kind = type(scaler).__name__
+        try:
+            from modules import modelloader
+            from modules.shared import cmd_opts
+            prefer_half = not cmd_opts.no_half and not cmd_opts.upcast_sampling
+            if kind in ("UpscalerRealESRGAN", "UpscalerDAT"):
+                path = AnimateDiffOutput._realesrgan_x2(scale) if kind == "UpscalerRealESRGAN" else None
+                if path:
+                    logger.info("Using RealESRGAN x2plus (the same family, native x2: ~3.5x faster than x4 and back down).")
+                else:
+                    path = scaler.load_model(upscaler.data_path).local_data_path
+                model = modelloader.load_spandrel_model(
+                    path, device=scaler.device, prefer_half=prefer_half,
+                    expected_architecture="DAT" if kind == "UpscalerDAT" else "ESRGAN")
+            elif kind == "UpscalerESRGAN":
+                model = scaler.load_model(upscaler.data_path)
+            else:
+                return None
+            try:
+                from modules_forge.forge_util import prepare_free_memory
+                prepare_free_memory()
+            except Exception:
+                pass
+            return model
+        except Exception as e:
+            logger.warning(f"Could not load {upscaler.name} once for all frames, upscaling frame by frame: {e}")
+            return None
+
+
+    @staticmethod
+    def _realesrgan_x2(scale: float):
+        """
+        R-ESRGAN 4x+ always works at x4. Up to x2, its official x2 model gives the same look for about a quarter
+        of the work (0.31 s instead of 1.1 s a 408x728 frame on an RTX 3070 laptop). Fetched once if missing.
+        """
+        if scale > 2:
+            return None
+        import os
+        from modules import modelloader
+        from modules.paths import models_path
+        folder = os.path.join(models_path, "RealESRGAN")
+        path = os.path.join(folder, "RealESRGAN_x2plus.pth")
+        if not os.path.isfile(path):
+            try:
+                modelloader.load_file_from_url(
+                    "https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.1/RealESRGAN_x2plus.pth",
+                    model_dir=folder, file_name="RealESRGAN_x2plus.pth")
+            except Exception as e:
+                logger.warning(f"Could not fetch RealESRGAN x2plus, using x4: {e}")
+                return None
+        return path if os.path.isfile(path) else None
+
+
+    @staticmethod
+    def _upscale_frame(model, image, size):
+        """Run the model until the picture reaches the size (a x4 model runs once for x2 or x4)."""
+        from modules.upscaler_utils import upscale_pil_patch, upscale_with_model
+        while image.width < size[0] or image.height < size[1]:
+            before = image.width
+            if image.width * image.height <= 1024 * 1024:
+                image = upscale_pil_patch(model, image)        # small frames go through whole: no tile seams
+            else:
+                image = upscale_with_model(model, image, tile_size=512, tile_overlap=32)
+            if image.width <= before:                          # a model that does not enlarge: stop
+                break
+        return image
+
