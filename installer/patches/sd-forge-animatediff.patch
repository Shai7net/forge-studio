+def figure_material(image: np.ndarray, mask: Image.Image):
+    """What was drawn inside the mask: its light colour, its dark colour, and where its light comes from (x, y)."""
+    inside = (np.array(mask.resize((image.shape[1], image.shape[0]), Image.NEAREST)) > 127).astype(np.uint8)
+    reach = max(1, round(image.shape[0] * 0.006))      # keeps clear of the soft edge of the mask
+    core = cv2.erode(inside, np.ones((2 * reach + 1, 2 * reach + 1), np.uint8))
+    if core.sum() < 200:
+        core = inside
+    if not core.any():
+        return np.array([225.0, 205.0, 170.0]), np.array([120.0, 95.0, 70.0]), np.array([0.5, -0.6])
+    luma = image.astype(np.float32) @ np.array([0.299, 0.587, 0.114], np.float32)
+    low, high = np.percentile(luma[core > 0], (20, 80))
+    light, dark = image[(core > 0) & (luma >= high)].mean(axis=0), image[(core > 0) & (luma <= low)].mean(axis=0)
+    # every figure on its own: where its light pixels lie against its dark ones
+    toward = np.zeros(2)
+    count, labels, stats, _ = cv2.connectedComponentsWithStats(core, 8)
+    for k in range(1, count):
