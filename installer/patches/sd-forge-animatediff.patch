+    def next_segment(self, p: StableDiffusionProcessing, n: int):
+        """
+        Before part n: every frame gets the noise it would have in one pass (seed + frame number), so the
+        frames two parts share start alike; then ControlNet is pointed at that part's frames and reloaded.
