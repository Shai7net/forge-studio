+    pictures = params.dance_regions and any(name in REGION_UNITS for name in names)
+    shape = "shape" in names and _style(params.dance_style) == SILHOUETTE_GRAY
+    pose = "pose" in names
+    if not (pictures or shape or pose) or not params.video_path:
+        return
+    raw_dir = Path(params.video_path).parent / RAW_DIR
+    frames = list_frames(params.video_path)[params.seg_start:params.seg_start + params.video_length]
+    regions = {}
+    if pictures:
+        inside = region_masks(str(raw_dir), frames, p.width, p.height)
+        regions.update(characters=inside, background=None if inside is None else 1.0 - inside)
+    if shape or pose:
+        around = region_masks(str(raw_dir), frames, p.width, p.height, grow=max(2, round(p.width / 8 * SHAPE_REACH)))
+        regions.update({name: around for name, wanted in (("shape", shape), ("pose", pose)) if wanted})
