@@ -0,0 +1,987 @@
+"""
+Dance transfer: objects that dance like the people in a video.
+
+- Frames are taken evenly at a fixed FPS (ffmpeg fps filter), so the render stays in sync with the
+  video's music. The old extractor (mpdecimate) drops similar frames and drifts.
+- A clean black-and-white silhouette of the dancers (YOLO, kept steady over time) goes to the QR Code
+  Monster ControlNet unit, which makes the object take the dancers' shape. Everything is cached per
+  video, FPS and mask settings, so trying another seed or prompt does not redo it.
+"""
+import gc
+import hashlib
+import os
+import subprocess
+import time
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageFilter
+
+from modules import shared
+from modules.paths import data_path
+
+from scripts.animatediff_logger import logger_animatediff as logger
+
+QR_MODEL_WORDS = ("qrcode", "qr_code", "monster")
+# QR Code Monster reads mid gray as "no instruction", black as "dark here" and white as "bright here"
+SILHOUETTE_GRAY = "White dancers on gray (keeps the prompt's background)"
+SILHOUETTE_BLACK = "White dancers on black (dark background)"
+SILHOUETTE_INVERT = "Black dancers on white"
+SILHOUETTE_STYLES = [SILHOUETTE_GRAY, SILHOUETTE_BLACK, SILHOUETTE_INVERT]
+_STYLE_TAG = {SILHOUETTE_GRAY: "gray", SILHOUETTE_BLACK: "black", SILHOUETTE_INVERT: "inv"}
+FRAME_EXT = (".png", ".jpg", ".jpeg", ".webp")
+
+
+def is_qr_unit(cn_unit) -> bool:
+    model = str(getattr(cn_unit, "model", "") or "").lower()
+    return any(word in model for word in QR_MODEL_WORDS)
+
+
+def _video_key(video: str) -> str:
+    """Content key: the same video uploaded again (new Gradio temp name) reuses the cache."""
+    size = os.path.getsize(video)
+    h = hashlib.md5(str(size).encode())
+    with open(video, "rb") as f:
+        h.update(f.read(1 << 20))
+        if size > 2 << 20:
+            f.seek(-(1 << 20), os.SEEK_END)
+            h.update(f.read(1 << 20))
+    return h.hexdigest()[:10]
+
+
+def cache_root(video: str, fps: float) -> Path:
+    base = shared.opts.data.get("animatediff_frame_extract_path", "") or f"{data_path}/tmp/animatediff-frames"
+    key = f"{fps:g}fps-{_video_key(video)}"
+    # the content decides: the same video uploaded under another name reuses what was made for it
+    existing = sorted(Path(base).glob(f"dance-*-{key}")) if Path(base).is_dir() else []
+    if existing:
+        return existing[0]
+    stem = "".join(c for c in Path(video).stem if c.isalnum() or c in "-_")[:40] or "video"
+    return Path(base) / f"dance-{stem}-{key}"
+
+
+def list_frames(folder) -> list:
+    folder = Path(folder)
+    if not folder.is_dir():
+        return []
+    return sorted(str(p) for p in folder.iterdir() if p.suffix.lower() in FRAME_EXT)
+
+
+def extract_frames_at_fps(video: str, fps: float) -> str:
+    """Frames taken evenly at `fps`, cached. Returns the frames folder."""
+    import imageio_ffmpeg
+
+    out = cache_root(video, fps) / "frames"
+    done = out / ".done"
+    if done.exists() and list_frames(out):
+        logger.info(f"Using cached frames ({len(list_frames(out))} at {fps:g} FPS): {out}")
+        return str(out)
+    out.mkdir(parents=True, exist_ok=True)
+    for old in list_frames(out):
+        os.remove(old)
+    cmd = [imageio_ffmpeg.get_ffmpeg_exe(), "-y", "-hide_banner", "-loglevel", "error",
+           "-i", video, "-vf", f"fps={fps:g}", "-qscale:v", "1", "-qmin", "1", str(out / "%09d.jpg")]
+    logger.info(f"Taking frames at {fps:g} FPS from {video}")
+    subprocess.run(cmd, check=True, capture_output=True)
+    done.touch()
+    logger.info(f"Took {len(list_frames(out))} frames: {out}")
+    return str(out)
+
+
+RAW_DIR = "silhouette-raw-v4"   # v4: v3 with edges refined by Segment Anything (v3: people kept over time, no half tones)
+YOLO_URL = "https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11m-seg.pt"
+MASK_SIDE = 960                 # the masks are worked out at this size; ControlNet resizes them to the picture anyway
+SURE, UNSURE = 0.35, 0.05       # YOLO confidence of a dancer: sure, and worth keeping only next to a sure one
+
+
+def _yolo_weights():
+    """Ultralytics' official YOLO11m person segmentation, kept in models/yolo (fetched once, 45 MB)."""
+    from modules import modelloader
+    from modules.paths import models_path
+    folder = os.path.join(models_path, "yolo")
+    path = os.path.join(folder, "yolo11m-seg.pt")
+    if not os.path.isfile(path):
+        modelloader.load_file_from_url(YOLO_URL, model_dir=folder, file_name="yolo11m-seg.pt")
+    return path
+
+
+def _mask_size(size) -> tuple:
+    width, height = size
+    scale = min(1.0, MASK_SIDE / max(width, height))
+    return max(8, round(width * scale)), max(8, round(height * scale))
+
+
+class DancerSegmenter:
+    """
+    Where the dancers are. YOLO finds people by shape, so dark clothes on a dark, smoky stage are found too;
+    u2net (the rembg model) finds the foreground by contrast and loses them, so it is only used for videos
+    without people, or when YOLO is not available.
+    """
+
+    def __init__(self):
+        self.yolo = self.u2net = None
+        try:
+            import torch
+            from ultralytics import YOLO
+            self.cuda = torch.cuda.is_available()
+            self.yolo = YOLO(_yolo_weights())
+        except Exception as e:
+            logger.warning(f"YOLO person segmentation unavailable, the silhouette uses u2net only: {e}")
+
+    def people(self, rgb: Image.Image, size) -> list:
+        """Every person YOLO sees, the unsure ones too: [(confidence, mask)], bool masks of `size` (w, h)."""
+        import cv2
+        result = self.yolo.predict(cv2.cvtColor(np.asarray(rgb), cv2.COLOR_RGB2BGR), classes=[0], conf=UNSURE,
+                                   retina_masks=True, verbose=False, device=0 if self.cuda else "cpu",
+                                   half=self.cuda)[0]
+        if result.masks is None:
+            return []
+        return [(float(conf), cv2.resize(mask.astype(np.float32), size, interpolation=cv2.INTER_AREA) > 0.5)
+                for mask, conf in zip(result.masks.data.cpu().numpy(), result.boxes.conf.cpu().numpy())]
+
+    def foreground(self, rgb: Image.Image, size) -> np.ndarray:
+        """The foreground by contrast (u2net), bool mask of `size`."""
+        import cv2
+        from rembg import new_session, remove
+        if self.u2net is None:
+            # after torch: once onnxruntime-gpu has loaded its own cuDNN, torch's cuDNN DLLs fail to load (WinError 127)
+            self.u2net = new_session("u2net", providers=["CUDAExecutionProvider", "CPUExecutionProvider"])
+        fine = np.asarray(remove(rgb, session=self.u2net, only_mask=True), dtype=np.uint8)
+        return cv2.resize(fine, size, interpolation=cv2.INTER_AREA) > 127
+
+    def mask(self, rgb: Image.Image) -> np.ndarray:
+        """One frame on its own, for the preview: bool mask at the mask size."""
+        size = _mask_size(rgb.size)
+        found = self.people(rgb, size) if self.yolo is not None else []
+        masks = [m for conf, m in found if conf >= 0.25] or [m for _, m in found]
+        return np.logical_or.reduce(masks) if masks else self.foreground(rgb, size)
+
+    def close(self):
+        self.u2net = self.yolo = None
+        gc.collect()
+        try:
+            import torch
+            torch.cuda.empty_cache()
+        except Exception:
+            pass
+
+
+def _pack(mask: np.ndarray) -> np.ndarray:
+    return np.packbits(mask)
+
+
+def _unpack(packed: np.ndarray, size) -> np.ndarray:
+    width, height = size
+    return np.unpackbits(packed)[:width * height].reshape(height, width).astype(bool)
+
+
+def _kept_over_time(found: list, size, sure: float) -> list:
+    """
+    Which of each frame's detections are dancers. A dancer in dark clothes is often seen with a low confidence,
+    and so is a shadow or a prop. An unsure detection is kept only where the frame before or after it has a
+    dancer in the same place, so a dancer does not blink out and a stray shape does not blink in.
+    """
+    import cv2
+    width, height = size
+    reach = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * max(1, int(height * 0.04)) + 1,) * 2)
+
+    def sweep(order):
+        kept, before = [set() for _ in found], None
+        for t in order:
+            near = cv2.dilate(before.astype(np.uint8), reach).astype(bool) if before is not None else None
+            union = np.zeros((height, width), bool)
+            for k, (confidence, packed) in enumerate(found[t]):
+                mask = _unpack(packed, size)
+                area = mask.sum()
+                if confidence >= sure or (near is not None and area and (mask & near).sum() >= 0.6 * area):
+                    kept[t].add(k)
+                    union |= mask
+            before = union if union.any() else None
+        return kept
+
+    forward, backward = sweep(range(len(found))), sweep(range(len(found) - 1, -1, -1))
+    return [f | b for f, b in zip(forward, backward)]
+
+
+def _tidy(mask: np.ndarray) -> np.ndarray:
+    """Small holes closed, specks dropped."""
+    import cv2
+    height, width = mask.shape
+    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * max(1, int(height * 0.006)) + 1,) * 2)
+    mask = cv2.morphologyEx(mask.astype(np.uint8), cv2.MORPH_CLOSE, kernel)
+    count, labels, stats, _ = cv2.connectedComponentsWithStats(mask, connectivity=8)
+    if count > 2:
+        areas = stats[1:, cv2.CC_STAT_AREA]
+        keep = [i + 1 for i, a in enumerate(areas) if a >= max(0.002 * width * height, 0.08 * areas.max())]
+        return np.isin(labels, keep)
+    return mask.astype(bool)
+
+
+def _drop_bystanders(masks: list) -> int:
+    """
+    Someone who hardly leaves one spot for the whole video and is much smaller than the dancers is a person in
+    the background. Left in, they become one more small figure. Their spot is found once for the whole video,
+    so they are dropped from every frame alike. Returns how many frames lost a shape.
+    """
+    import cv2
+    if len(masks) < 8:
+        return 0
+    height = masks[0].shape[0]
+    seen = np.zeros(masks[0].shape, np.uint16)
+    largest = []
+    parts = []
+    for mask in masks:
+        seen += mask
+        count, labels, stats, _ = cv2.connectedComponentsWithStats(mask.astype(np.uint8), connectivity=8)
+        parts.append((count, labels, stats))
+        if count > 1:
+            largest.append(stats[1:, cv2.CC_STAT_AREA].max())
+    if not largest:
+        return 0
+    dancer = float(np.median(largest))           # the usual size of a dancer in this video
+    still = (seen >= 0.5 * len(masks)).astype(np.uint8)
+    count, labels, stats, _ = cv2.connectedComponentsWithStats(still, connectivity=8)
+    spots = np.zeros(still.shape, np.uint8)
+    for i in range(1, count):
+        if stats[i, cv2.CC_STAT_AREA] < 0.25 * dancer:
+            spots[labels == i] = 1
+    if not spots.any():
+        return 0
+    reach = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * max(1, int(height * 0.02)) + 1,) * 2)
+    spots = cv2.dilate(spots, reach).astype(bool)
+    dropped = 0
+    for mask, (count, labels, stats) in zip(masks, parts):
+        hit = False
+        for i in range(1, count):
+            area = stats[i, cv2.CC_STAT_AREA]
+            if area < 0.5 * dancer:
+                part = labels == i
+                if (part & spots).sum() >= 0.6 * area:
+                    mask[part] = False
+                    hit = True
+        dropped += hit
+    return dropped
+
+
+SAM_MODELS = (("vit_l", "sam_vit_l_0b3195.pth"), ("vit_h", "sam_vit_h_4b8939.pth"), ("vit_b", "sam_vit_b_01ec64.pth"))
+
+
+def _sam_checkpoint():
+    """A Segment Anything model already on this computer, the large one first: (kind, path), or None."""
+    from modules.paths import models_path
+    folders = [os.path.join(models_path, "sam"),
+               os.path.join(data_path, "extensions", "sd-webui-segment-anything", "models", "sam")]
+    for kind, name in SAM_MODELS:
+        for folder in folders:
+            if os.path.isfile(os.path.join(folder, name)):
+                return kind, os.path.join(folder, name)
+    return None
+
+
+def _sam_prompt(mask: np.ndarray) -> np.ndarray:
+    """A mask as Segment Anything's mask prompt: logits, 256 px on the long side, padded to 256x256."""
+    import cv2
+    height, width = mask.shape
+    scale = 256.0 / max(height, width)
+    small = cv2.resize(mask.astype(np.float32), (int(width * scale + 0.5), int(height * scale + 0.5)),
+                       interpolation=cv2.INTER_AREA)
+    prompt = np.full((256, 256), -8.0, np.float32)
+    prompt[:small.shape[0], :small.shape[1]] = small * 16.0 - 8.0
+    return prompt[None]
+
+
+def _refine_edges(frames: list, masks: list) -> list:
+    """
+    The masks say who the dancers are, but their edges are loose (YOLO draws masks at a coarse size), so a rim
+    of background comes along and gets drawn as part of the figure. Segment Anything cuts each shape again from
+    its box, the shape itself and a few points inside it. Its cut is taken only where it agrees with the shape;
+    it may not reach far outside the dancers and may not open holes in them (a white dress on a white curtain).
+    Without a Segment Anything model on disk, or without a GPU, the masks stay as they are.
+    """
+    found = _sam_checkpoint()
+    if found is None or not masks:
+        return masks
+    import cv2
+    started = time.time()
+    try:
+        import torch
+        if not torch.cuda.is_available():
+            return masks
+        from segment_anything import SamPredictor, sam_model_registry
+        try:    # Forge's own models leave the GPU while this runs; Forge brings them back when it draws
+            from ldm_patched.modules import model_management
+            model_management.unload_all_models()
+            model_management.soft_empty_cache()
+        except Exception:
+            pass
+        kind, path = found
+        sam = sam_model_registry[kind](checkpoint=path).to("cuda").eval()
+        predictor = SamPredictor(sam)
+    except Exception as e:
+        logger.warning(f"Segment Anything is unavailable, the dancers keep their rougher edges: {e}")
+        return masks
+    logger.info(f"Refining the dancers' edges with Segment Anything ({kind}) in {len(masks)} frames...")
+    height, width = masks[0].shape
+    reach = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * max(1, int(height * 0.02)) + 1,) * 2)
+    core = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * max(1, int(height * 0.012)) + 1,) * 2)
+    refined = []
+    try:
+        for frame, mask in zip(frames, masks):
+            if not mask.any():
+                refined.append(mask)
+                continue
+            with Image.open(frame) as im:
+                predictor.set_image(np.asarray(im.convert("RGB").resize((width, height), Image.LANCZOS)))
+            count, labels, stats, _ = cv2.connectedComponentsWithStats(mask.astype(np.uint8), connectivity=8)
+            fine = np.zeros_like(mask)
+            for i in range(1, count):
+                part = labels == i
+                x, y, w, h = stats[i, :4]
+                pad = 0.03 * max(w, h)
+                box = np.array([max(0, x - pad), max(0, y - pad), min(width, x + w + pad), min(height, y + h + pad)])
+                depth = cv2.distanceTransform(part.astype(np.uint8), cv2.DIST_L2, 5)
+                points = []
+                for _ in range(4):                       # a few points deep inside the shape
+                    py, px = np.unravel_index(depth.argmax(), depth.shape)
+                    if depth[py, px] < 2:
+                        break
+                    points.append((px, py))
+                    cv2.circle(depth, (int(px), int(py)), int(max(6, depth[py, px] * 1.5)), 0, -1)
+                cut, _, _ = predictor.predict(
+                    point_coords=np.array(points, np.float32) if points else None,
+                    point_labels=np.ones(len(points), np.int32) if points else None,
+                    box=box, mask_input=_sam_prompt(part), multimask_output=False)
+                agree = (cut[0] & part).sum() / max((cut[0] | part).sum(), 1)
+                fine |= cut[0] if agree >= 0.7 else part
+            near = cv2.dilate(mask.astype(np.uint8), reach).astype(bool)
+            inside = cv2.erode(mask.astype(np.uint8), core).astype(bool)
+            refined.append(_tidy((fine & near) | inside))
+    except Exception as e:
+        logger.warning(f"Segment Anything stopped ({e}), so the dancers keep their rougher edges.")
+        refined = masks
+    finally:
+        del predictor, sam
+        gc.collect()
+        torch.cuda.empty_cache()
+    logger.info(f"Edges refined in {time.time() - started:.0f} s.")
+    return refined
+
+
+def dancer_masks(frames: list, fps: float = 12.0):
+    """
+    A clean black-and-white mask of the dancers for every frame (bool arrays at the mask size).
+    QR Code Monster reads every gray tone and every stray shape as something to draw, so a ghost of the
+    neighbouring poses, a floor shadow or a frame without the dancers fills the whole background with clutter.
+    """
+    def load(frame):
+        with Image.open(frame) as im:
+            return im.convert("RGB")
+
+    with Image.open(frames[0]) as im:
+        size = _mask_size(im.size)
+    width, height = size
+    segmenter = DancerSegmenter()
+    try:
+        found = []
+        if segmenter.yolo is not None:
+            found = [[(c, _pack(m)) for c, m in segmenter.people(load(frame), size)] for frame in frames]
+        best = np.array([max((c for c, _ in f), default=0.0) for f in found])
+        sure = next((s for s in (SURE, 0.2) if len(best) and (best >= s).mean() >= 0.3), None)
+        if sure is None:
+            logger.info("No people found in this video, so the silhouette is the foreground by contrast (u2net).")
+            masks = [segmenter.foreground(load(frame), size) for frame in frames]
+        else:
+            kept = _kept_over_time(found, size, sure)
+            masks = []
+            for t, keep in enumerate(kept):
+                union = np.zeros((height, width), bool)
+                for k in keep:
+                    union |= _unpack(found[t][k][1], size)
+                masks.append(union)
+    finally:
+        segmenter.close()
+
+    bystanders = _drop_bystanders(masks)
+
+    # the dancers' lowest point moves smoothly: a mask that suddenly reaches lower took the shadow on the floor
+    bottom = np.array([rows[-1] if len(rows) else -1
+                       for rows in (np.flatnonzero(m.sum(axis=1) >= 0.01 * width) for m in masks)])
+    span = max(2, round(fps / 2))
+    cut = 0
+    for t, mask in enumerate(masks):
+        around = bottom[max(0, t - span):t + span + 1]
+        around = around[around >= 0]
+        if len(around) and bottom[t] > np.median(around) + 0.025 * height:
+            mask[int(np.median(around) + 0.025 * height) + 1:] = False
+            cut += 1
+    masks = [_tidy(m) for m in masks]
+
+    # a frame that still lost most of the dancers takes the nearest good frame
+    area = np.array([m.mean() for m in masks])
+    usual = np.array([np.median(area[max(0, t - 3):t + 4]) for t in range(len(masks))])
+    gaps = set(np.flatnonzero(area < 0.4 * usual).tolist())
+    for t in gaps:
+        good = [s for s in sorted(range(len(masks)), key=lambda s: abs(s - t)) if s not in gaps]
+        if good:
+            masks[t] = masks[good[0]]
+    logger.info(f"Dancers found in {len(masks)} frames; floor shadow cut in {cut}, {len(gaps)} gaps filled"
+                + (f", a bystander left out of {bystanders} frames." if bystanders else "."))
+    return _refine_edges(frames, masks)
+
+
+def _style(style) -> str:
+    return style if style in SILHOUETTE_STYLES else SILHOUETTE_GRAY
+
+
+def _finish_mask(mask: np.ndarray, style, softness: float) -> Image.Image:
+    """Black-and-white mask (bool or 0..255) to the hint QR Code Monster gets; `softness` is a blur radius in px."""
+    if mask.dtype == bool:
+        mask = mask * 255.0
+    img = Image.fromarray(np.clip(mask, 0, 255).astype(np.uint8), "L")
+    if softness > 0:
+        img = img.filter(ImageFilter.GaussianBlur(radius=softness))
+    style = _style(style)
+    if style == SILHOUETTE_INVERT:
+        img = Image.eval(img, lambda v: 255 - v)
+    elif style == SILHOUETTE_GRAY:
+        img = Image.eval(img, lambda v: 128 + v * 127 // 255)
+    return img
+
+
+def make_silhouettes(frames_dir: str, style=SILHOUETTE_GRAY, softness: float = 6, fps: float = 12.0) -> str:
+    """Silhouette of the dancers for every frame. Cached."""
+    frames = list_frames(frames_dir)
+    out = Path(frames_dir).parent / f"silhouette-v4-{_STYLE_TAG[_style(style)]}-soft{softness:g}"
+    done = out / ".done"
+    if done.exists() and len(list_frames(out)) == len(frames):
+        logger.info(f"Using cached silhouettes: {out}")
+        return str(out)
+    out.mkdir(parents=True, exist_ok=True)
+
+    # the black-and-white masks are shared by every style/softness choice (and by the dancer/background regions)
+    raw_dir = Path(frames_dir).parent / RAW_DIR
+    raw_paths = [raw_dir / f"{Path(frame).stem}.png" for frame in frames]
+    if not ((raw_dir / ".done").exists() and all(p.exists() for p in raw_paths)):
+        raw_dir.mkdir(exist_ok=True)
+        logger.info(f"Finding the dancers in {len(frames)} frames (YOLO)...")
+        for path, mask in zip(raw_paths, dancer_masks(frames, fps)):
+            Image.fromarray(mask.astype(np.uint8) * 255, "L").save(path)
+        (raw_dir / ".done").touch()
+
+    with Image.open(frames[0]) as im:
+        frame_width = im.size[0]
+    for frame, raw_path in zip(frames, raw_paths):
+        with Image.open(raw_path) as raw:
+            mask = np.asarray(raw.convert("L"))
+        # softness is given in px of the video; the mask is smaller
+        _finish_mask(mask, style, softness * mask.shape[1] / frame_width).save(out / f"{Path(frame).stem}.png")
+    done.touch()
+    logger.info(f"Silhouettes ready: {out}")
+    return str(out)
+
+
+def preview_silhouettes(video: str, style, softness: float, count: int = 6):
+    """A few silhouettes spread over the video, for a quick look before rendering."""
+    import cv2
+    cap = cv2.VideoCapture(video)
+    total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT)) or 1
+    segmenter = DancerSegmenter()
+    images = []
+    try:
+        for k in range(count):
+            cap.set(cv2.CAP_PROP_POS_FRAMES, int(total * (k + 0.5) / count))
+            ok, frame = cap.read()
+            if not ok:
+                continue
+            rgb = Image.fromarray(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
+            mask = segmenter.mask(rgb)
+            images.append(_finish_mask(mask, style, softness * mask.shape[1] / rgb.size[0]))
+    finally:
+        cap.release()
+        segmenter.close()
+    return images
+
