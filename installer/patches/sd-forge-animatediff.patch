+    areas = [dot[1] for _, dots in found for dot in dots]
+    if not areas or sum(bool(dots) for _, dots in found) < 0.25 * len(masks):
+        return None
+    usual = float(np.median(areas))
+    balls = []
+    for index, (labels, dots) in enumerate(found):
+        dots = [dot for dot in dots if 0.5 * usual <= dot[1] <= 2 * usual]
+        if dots:
