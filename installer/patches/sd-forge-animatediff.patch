+def find_balls(masks: list):
+    """
+    A small dot in the masks, such as a ball marked by hand. The dots are taken out of the masks (in place) and
+    drawn as a ball once the frame is finished, see draw_balls.
+
+    A dot counts when it is small, about as wide as it is tall, about the size of the other dots, and there in at
+    least a quarter of the frames. That keeps out a hand or a paddle that broke off its figure in a frame or two.
+    Returns for every frame its dots as (centre x, centre y, diameter) in parts of the mask's width and height,
+    or None when the masks have no such dots.
+    """
+    found = []
+    for mask in masks:
+        binary = (np.array(mask) > 127).astype(np.uint8)
+        count, labels, stats, centres = cv2.connectedComponentsWithStats(binary, 8)
+        dots = []
+        for k in range(1, count):
+            _, _, w, h, area = stats[k]
+            if BALL_SMALLEST * binary.size <= area <= BALL_LARGEST * binary.size and 0.5 <= w / h <= 2 and area >= 0.55 * w * h:
+                dots.append((k, area, centres[k], w, h))
+        found.append((labels, dots))
