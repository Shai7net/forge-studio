+def paint_ball(image: np.ndarray, x: float, y: float, diameter: float, material):
+    """A ball shaded like the figures, straight onto the frame."""
+    light, dark, toward = material
+    radius = max(1.5, diameter / 2)
+    x1, y1 = max(0, int(x - radius) - 1), max(0, int(y - radius) - 1)
+    x2, y2 = min(image.shape[1], int(x + radius) + 2), min(image.shape[0], int(y + radius) + 2)
+    if x2 <= x1 or y2 <= y1:
+        return
