+# פונקציה ליצירת שם תיקייה רנדומלי
+def generate_random_dir(base_path):
+    random_str = ''.join(random.choices(string.ascii_letters + string.digits, k=8))
+    return Path(base_path) / f"output_{random_str}"
 
+# פונקציה לחילוץ פריימים מווידאו
+def extract_frames(video_path, output_dir):
+    vidcap = cv2.VideoCapture(video_path)
+    success, image = vidcap.read()
+    count = 0
+    frames = []
+    while success:
+        frame_path = output_dir / f"frame_{count:04d}.png"
+        cv2.imwrite(str(frame_path), image)
+        frames.append(frame_path)
+        success, image = vidcap.read()
+        count += 1
+    vidcap.release()
+    return frames
 
+# פונקציה ליצירת סרטון מפריימים
+def create_video_from_frames(frames_dir, output_video_path, fps):
+    frames = sorted(Path(frames_dir).glob("*.png"))
+    if not frames:
+        return None
+    img = cv2.imread(str(frames[0]))
+    height, width, layers = img.shape
+    fourcc = cv2.VideoWriter_fourcc(*'mp4v')
+    video = cv2.VideoWriter(output_video_path, fourcc, fps, (width, height))
+    for frame in frames:
+        video.write(cv2.imread(str(frame)))
+    video.release()
+    return output_video_path
 
