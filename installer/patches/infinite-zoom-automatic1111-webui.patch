+                text, keyframes_fps, keyframes_mode, video_fps, zoom_speed,
+                zoom_in=zoom_mode == 1, zoom_factor=image_zoom_factor,
+                audio_duration=audio_duration, max_steps=available,
+            )
+            lines = [
+                line
+                for line in describe_plan(image_plan, available_steps=available).split("\n\n")
+                if line.startswith("**Zoom:**")
+            ]
+            sections.append(f"**IMG tab ({available + 1} images):**\n\n" + "\n\n".join(lines))
+        return "\n\n---\n\n".join(sections)
+    except (KeyframeError, AudioError) as err:
+        return f"**Cannot use these keyframes:** {err}"
+
+
+def generate_keyframes_from_soundtrack(soundtrack, function, generator_fps, video_fps):
+    path = upload_path(soundtrack)
+    if not path:
+        return gr.update(), gr.update(), "**Upload a soundtrack first** (Soundtrack section above)."
+    fps = float(generator_fps) if generator_fps and generator_fps > 0 else float(video_fps)
+    try:
+        text, values, seconds = keyframes_from_audio(path, fps, function)
+    except (KeyframeError, AudioError) as err:
+        return gr.update(), gr.update(), f"**Could not generate keyframes:** {err}"
+    return (
+        text,
+        fps,
+        f"Generated {len(values):,} keyframes at {fps:g} fps from {clock(seconds)} of audio "
+        f"(values {values.min():.2f} to {values.max():.2f}).",
+    )
