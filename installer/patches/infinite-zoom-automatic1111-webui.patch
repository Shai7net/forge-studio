@@ -0,0 +1,173 @@
+import math
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from iz_helpers import audio  # noqa: E402
+
+DURATION = 3.2
+FORMATS = [  # file name, encoder
+    ("tone.wav", "pcm_s16le"),
+    ("tone.mp3", "libmp3lame"),
+    ("tone.flac", "flac"),
+    ("tone.ogg", "libvorbis"),
+    ("tone.opus", "libopus"),
+    ("tone.m4a", "aac"),
+    ("tone_alac.m4a", "alac"),
+    ("tone.wma", "wmav2"),
+    ("tone.aiff", "pcm_s16be"),
+    ("tone.ac3", "ac3"),
+    ("tone.mka", "flac"),
+    ("tone.webm", "libopus"),
+]
+TONE = ["-f", "lavfi", "-i", f"sine=frequency=440:duration={DURATION}:sample_rate=44100"]
+
+
+class AudioTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.ffmpeg = audio.ffmpeg_exe()
+        cls.tmp = tempfile.mkdtemp(prefix="iz_audio_test_")
+        encoders = subprocess.run([cls.ffmpeg, "-hide_banner", "-encoders"],
+                                  capture_output=True, text=True, errors="replace").stdout
+        cls.formats = {}
+        for name, encoder in FORMATS:
+            if re.search(rf"\s{re.escape(encoder)}\s", encoders):
+                cls.formats[name] = cls._make(name, TONE + ["-ac", "2", "-c:a", encoder])
+        cls.mono = cls._make("mono.wav", TONE + ["-ac", "1", "-c:a", "pcm_s16le"])
+        cls.surround = cls._make("surround.flac", TONE + ["-ac", "6", "-c:a", "flac"])
+        cls.hires = cls._make("hires.flac", ["-f", "lavfi", "-i",
+                                             f"sine=frequency=440:duration={DURATION}:sample_rate=96000",
+                                             "-c:a", "flac"])
+        cls.video_with_audio = cls._make("clip.mp4", ["-f", "lavfi", "-i", f"color=c=blue:s=64x64:d={DURATION}",
+                                                      *TONE, "-c:v", "libx264", "-pix_fmt", "yuv420p",
+                                                      "-c:a", "aac", "-shortest"])
+        cls.not_audio = os.path.join(cls.tmp, "notes.txt")
+        with open(cls.not_audio, "w") as f:
+            f.write("not a sound")
+        cls.silent_2s = cls._silent_video("silent2.mp4", 2.0)
+        cls.silent_5s = cls._silent_video("silent5.mp4", 5.0)
+
+    @classmethod
+    def tearDownClass(cls):
+        shutil.rmtree(cls.tmp, ignore_errors=True)
+
+    @classmethod
+    def _make(cls, name, args):
+        path = os.path.join(cls.tmp, name)
+        subprocess.run([cls.ffmpeg, "-hide_banner", "-v", "error", "-y", *args, path], check=True)
+        return path
+
+    @classmethod
+    def _silent_video(cls, name, seconds, fps=24):
+        import imageio
+
+        path = os.path.join(cls.tmp, name)
+        writer = imageio.get_writer(path, fps=fps, macro_block_size=None)
+        frame = np.zeros((64, 64, 3), dtype=np.uint8)
+        for _ in range(int(round(seconds * fps))):
+            writer.append_data(frame)
+        writer.close()
+        return path
+
+    def streams(self, path):
+        text = subprocess.run([self.ffmpeg, "-hide_banner", "-i", path],
+                              capture_output=True, text=True, errors="replace").stderr
+        video = re.findall(r"Stream #\S+: Video: (\w+)", text)
+        sound = re.findall(r"Stream #\S+: Audio: (\w+)", text)
+        h, m, s = re.search(r"Duration:\s*(\d+):(\d+):(\d+(?:\.\d+)?)", text).groups()
+        return video, sound, int(h) * 3600 + int(m) * 60 + float(s)
+
+    def all_sources(self):
+        return list(self.formats.items()) + [
+            ("mono.wav", self.mono), ("surround.flac", self.surround),
+            ("hires.flac", self.hires), ("clip.mp4", self.video_with_audio),
+        ]
+
+    def test_fixtures_cover_the_common_formats(self):
+        self.assertGreaterEqual(len(self.formats), 10, sorted(self.formats))
+
+    def test_probe_every_format(self):
+        for name, path in self.all_sources():
+            with self.subTest(name=name):
+                info = audio.probe_audio(path)
+                self.assertAlmostEqual(info.duration, DURATION, delta=0.15)
+                self.assertTrue(info.codec)
+                self.assertIn(name, info.describe())
+
+    def test_probe_rejects_files_without_sound(self):
+        for path in (self.not_audio, self.silent_2s, os.path.join(self.tmp, "missing.mp3")):
+            with self.subTest(path=path):
+                with self.assertRaises(audio.AudioError):
+                    audio.probe_audio(path)
+
+    def test_decode_is_stereo_48k(self):
+        for path in (self.formats["tone.mp3"], self.mono, self.surround, self.hires):
+            with self.subTest(path=os.path.basename(path)):
+                pcm = audio.decode_audio(path)
+                self.assertEqual(pcm.shape[1], 2)
+                self.assertAlmostEqual(pcm.shape[0] / audio.DECODE_SAMPLE_RATE, DURATION, delta=0.1)
+                # lavfi sine peaks at 1/8 and the mono -> stereo up-mix is -3 dB, so ~0.088
+                self.assertGreater(float(np.abs(pcm).max()), 0.05)
+
+    def test_keyframes_from_audio(self):
+        text, values, seconds = audio.keyframes_from_audio(self.formats["tone.wav"], 12)
+        self.assertEqual(len(values), math.ceil(seconds * 12))
+        self.assertEqual(text.count(": ("), len(values))
+        self.assertGreaterEqual(values.min(), 1.0)
+        self.assertAlmostEqual(values.max(), 2.0)
+
+    def test_mux_cuts_long_audio(self):
+        out = os.path.join(self.tmp, "cut.mp4")
+        audio.mux_soundtrack(self.silent_2s, self.formats["tone.mp3"], out, 2.0, fade_out=1.0)
+        video, sound, duration = self.streams(out)
+        self.assertEqual((video, sound), (["h264"], ["aac"]))
+        self.assertAlmostEqual(duration, 2.0, delta=0.1)
+
+    def test_mux_pads_short_audio(self):
+        out = os.path.join(self.tmp, "padded.mp4")
+        audio.mux_soundtrack(self.silent_5s, self.formats["tone.mp3"], out, 5.0, fade_out=1.0)
+        video, sound, duration = self.streams(out)
+        self.assertEqual((video, sound), (["h264"], ["aac"]))
+        self.assertAlmostEqual(duration, 5.0, delta=0.1)
+
+    def test_mux_every_format(self):
+        for name, path in self.all_sources():
+            with self.subTest(name=name):
+                out = os.path.join(self.tmp, f"muxed_{name}.mp4")
+                audio.mux_soundtrack(self.silent_2s, path, out, 2.0, fade_out=0.5)
+                video, sound, duration = self.streams(out)
+                self.assertEqual((video, sound), (["h264"], ["aac"]))
+                self.assertAlmostEqual(duration, 2.0, delta=0.1)
+
+    def test_attach_success_replaces_silent_render(self):
+        silent = os.path.join(self.tmp, "render_ok_silent.mp4")
+        final = os.path.join(self.tmp, "render_ok.mp4")
+        shutil.copy(self.silent_2s, silent)
+        added, message = audio.attach_soundtrack(silent, final, self.formats["tone.flac"], 2.0, 1.0)
+        self.assertTrue(added, message)
+        self.assertTrue(os.path.isfile(final))
+        self.assertFalse(os.path.exists(silent))
+
+    def test_attach_failure_keeps_the_render(self):
+        silent = os.path.join(self.tmp, "render_bad_silent.mp4")
+        final = os.path.join(self.tmp, "render_bad.mp4")
+        shutil.copy(self.silent_2s, silent)
+        added, message = audio.attach_soundtrack(silent, final, self.not_audio, 2.0, 1.0)
+        self.assertFalse(added)
+        self.assertIn("without sound", message)
+        self.assertTrue(os.path.isfile(final))
+        self.assertFalse(os.path.exists(silent))
+        self.assertEqual(self.streams(final)[1], [])
+
+
+if __name__ == "__main__":
