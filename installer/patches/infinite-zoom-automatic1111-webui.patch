+
+from iz_helpers import keyframes as kf  # noqa: E402
+
+PYTTI_SAMPLE = (
+    '(lambda builtins, fps, kf: kf[builtins["min"](kf, key = lambda x: builtins["abs"](x-(t*fps)//1))])'
+    '([a for a in (1).__class__.__base__.__subclasses__() if a.__name__ == "catch_warnings"][0]()'
+    '._module.__builtins__, 12, {0: (1.00), 1: (1.53), 2: (2.00)})'
+)
+
+
+class ParseTest(unittest.TestCase):
+    def test_disco_from_generator(self):
+        frames = kf.parse_keyframes("0: (1.00), 1: (1.53), 2: (2.00)")
+        self.assertEqual(frames.format, "Disco/Deforum")
+        self.assertEqual(frames.points, [(0, 1.0), (1, 1.53), (2, 2.0)])
+        self.assertIsNone(frames.fps)
+
+    def test_sparse_deforum_is_interpolated(self):
+        dense = kf.parse_keyframes("0: (1.0), 10: (2.0)").dense()
+        self.assertEqual(len(dense), 11)
+        self.assertAlmostEqual(dense[5], 1.5)
+
+    def test_values_before_first_key_hold(self):
+        dense = kf.parse_keyframes("5: (2.0), 10: (1.0)").dense()
+        self.assertTrue(np.all(dense[:6] == 2.0))
+        self.assertAlmostEqual(dense[10], 1.0)
+
+    def test_disco_without_parentheses_and_newlines(self):
+        frames = kf.parse_keyframes("0: 1,\n1: 1.5\n2:2")
+        self.assertEqual(frames.points, [(0, 1.0), (1, 1.5), (2, 2.0)])
+
+    def test_pytti_is_read_not_executed(self):
+        frames = kf.parse_keyframes(PYTTI_SAMPLE)
+        self.assertEqual(frames.format, "PyTTI")
+        self.assertEqual(frames.fps, 12.0)
+        self.assertEqual(frames.points, [(0, 1.0), (1, 1.53), (2, 2.0)])
+
+    def test_csv_single_column(self):
+        frames = kf.parse_keyframes("1.00\n1.53\r\n2.00\n")
+        self.assertEqual(frames.format, "CSV")
+        self.assertEqual(frames.points, [(0, 1.0), (1, 1.53), (2, 2.0)])
+
+    def test_csv_two_columns_with_header(self):
+        frames = kf.parse_keyframes("frame,value\n0,1\n4,2")
+        self.assertEqual(frames.points, [(0, 1.0), (4, 2.0)])
+
+    def test_json_list_and_object(self):
+        self.assertEqual(kf.parse_keyframes("[1, 1.5]").points, [(0, 1.0), (1, 1.5)])
+        self.assertEqual(kf.parse_keyframes('{"0": 1, "3": 2}').points, [(0, 1.0), (3, 2.0)])
+        self.assertEqual(kf.parse_keyframes("[[0, 1], [2, 3]]").points, [(0, 1.0), (2, 3.0)])
+
+    def test_bom_is_ignored(self):
+        self.assertEqual(kf.parse_keyframes("﻿0: (1.00)").points, [(0, 1.0)])
+
+    def test_rejections(self):
+        bad = [
+            "",
+            "   ",
+            "0: (1.02+0.01*sin(t))",
+            "0: (1), 0: (2)",
+            "hello",
+            "[[-1, 1]]",
+            '{"0": NaN}',
+            "0.5,1",
+            "a,b,c\n1,2,3",
