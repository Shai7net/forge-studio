@@ -0,0 +1,171 @@
+"""Soundtrack support: find ffmpeg, inspect and decode audio, mux the soundtrack into a video.
+
+No webui imports. ffmpeg decodes practically every audio format (and the audio track of
+video files), so the extension accepts anything ffmpeg can read and validates it by probing.
+"""
+import os
+import re
+import shutil
+import subprocess
+
+import numpy as np
+
+from .keyframes import GENERATOR_DEFAULT_FUNCTION, generate_keyframes
+
+SOUNDTRACK_FILE_TYPES = [
+    "audio", "video",
+    ".mp3", ".wav", ".flac", ".ogg", ".oga", ".opus", ".m4a", ".aac", ".wma", ".aiff", ".aif",
+    ".alac", ".ape", ".wv", ".ac3", ".amr", ".mka", ".webm", ".mp4", ".mov", ".mkv",
+]
+DECODE_SAMPLE_RATE = 48000
+AAC_BITRATE = "192k"
+
+_DURATION = re.compile(r"Duration:\s*(\d+):(\d+):(\d+(?:\.\d+)?)")
+_TIME = re.compile(r"time=\s*(\d+):(\d+):(\d+(?:\.\d+)?)")
+_AUDIO_STREAM = re.compile(
+    r"Stream #\d+:\d+(?:\[[^\]]*\])?(?:\([^)]*\))?: Audio: ([^,\n]+)(?:,\s*(\d+) Hz)?(?:,\s*([^,\n]+))?"
+)
+
+
+class AudioError(RuntimeError):
+    pass
+
+
+def ffmpeg_exe():
+    try:
+        import imageio_ffmpeg
+
+        return imageio_ffmpeg.get_ffmpeg_exe()
+    except Exception:
+        path = shutil.which("ffmpeg")
+        if path:
+            return path
+    raise AudioError("ffmpeg was not found. Install imageio-ffmpeg or put ffmpeg on PATH.")
+
+
+def _run(args, timeout=None):
+    kwargs = {"creationflags": 0x08000000} if os.name == "nt" else {}  # CREATE_NO_WINDOW
+    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout, **kwargs)
+
+
+def _seconds(match):
+    hours, minutes, seconds = match.groups()
+    return int(hours) * 3600 + int(minutes) * 60 + float(seconds)
+
+
+def clock(seconds):
+    minutes, rest = divmod(max(float(seconds), 0.0), 60)
+    return f"{int(minutes)}:{rest:04.1f}"
+
+
+class AudioInfo:
+    def __init__(self, path, duration, codec, sample_rate, layout):
+        self.path = path
+        self.duration = duration
+        self.codec = codec
+        self.sample_rate = sample_rate
+        self.layout = layout
+
+    def describe(self):
+        details = [self.codec]
+        if self.sample_rate:
+            details.append(f"{self.sample_rate / 1000:g} kHz")
+        if self.layout:
+            details.append(self.layout)
+        return f"{os.path.basename(self.path)}: {clock(self.duration)} ({', '.join(details)})"
+
+
+def probe_audio(path):
+    if not path or not os.path.isfile(path):
+        raise AudioError("The soundtrack file is missing.")
+    name = os.path.basename(path)
+    exe = ffmpeg_exe()
+    text = _run([exe, "-hide_banner", "-i", path], timeout=120).stderr.decode("utf-8", errors="replace")
+    stream = _AUDIO_STREAM.search(text)
+    if not stream:
+        raise AudioError(f"{name} has no audio track that ffmpeg can read.")
+
+    duration_match = _DURATION.search(text)
+    duration = _seconds(duration_match) if duration_match else 0.0
+    if duration <= 0:
+        # no usable header duration (raw streams): decode once and read the final timestamp
+        log = _run([exe, "-hide_banner", "-i", path, "-map", "0:a:0", "-f", "null", "-"])
+        times = _TIME.findall(log.stderr.decode("utf-8", errors="replace"))
+        if times:
+            hours, minutes, seconds = times[-1]
+            duration = int(hours) * 3600 + int(minutes) * 60 + float(seconds)
+    if duration <= 0:
+        raise AudioError(f"Could not determine how long {name} is.")
+
+    codec = stream.group(1).split()[0]
+    sample_rate = int(stream.group(2)) if stream.group(2) else None
+    layout = stream.group(3).strip() if stream.group(3) else None
+    return AudioInfo(path, duration, codec, sample_rate, layout)
+
+
+def decode_audio(path, sample_rate=DECODE_SAMPLE_RATE):
+    """First audio track as (samples, 2) float32. Mono is duplicated, surround is down-mixed."""
+    probe_audio(path)
+    result = _run([
+        ffmpeg_exe(), "-hide_banner", "-v", "error", "-i", path,
+        "-map", "0:a:0", "-vn", "-ac", "2", "-ar", str(sample_rate),
+        "-f", "f32le", "-acodec", "pcm_f32le", "-",
+    ])
+    if result.returncode != 0:
+        raise AudioError(f"ffmpeg could not decode {os.path.basename(path)}: {_tail(result.stderr)}")
+    usable = len(result.stdout) // 8 * 8
+    pcm = np.frombuffer(result.stdout[:usable], dtype=np.float32).reshape(-1, 2)
+    if pcm.shape[0] == 0:
+        raise AudioError(f"{os.path.basename(path)} decoded to no samples.")
+    return pcm
+
+
+def keyframes_from_audio(path, fps, expression=GENERATOR_DEFAULT_FUNCTION):
+    """Disco keyframes from a soundtrack, computed like the web generator. Returns (text, values, seconds)."""
+    pcm = decode_audio(path)
+    text, values = generate_keyframes(pcm, DECODE_SAMPLE_RATE, fps, expression)
+    return text, values, pcm.shape[0] / DECODE_SAMPLE_RATE
+
+
+def _tail(stderr, lines=6):
+    text = stderr.decode("utf-8", errors="replace").strip().splitlines()
+    return " | ".join(text[-lines:]) if text else "no details"
+
+
+def mux_soundtrack(video_path, audio_path, output_path, video_duration, fade_out=1.0, audio_duration=None):
+    """Writes video_path's video with the soundtrack cut (with fade-out) or padded to video_duration."""
+    if audio_duration is None:
+        audio_duration = probe_audio(audio_path).duration
+    filters = ["apad"]
+    if fade_out and fade_out > 0 and audio_duration > video_duration + 0.05:
+        fade = min(float(fade_out), video_duration)
+        filters.append(f"afade=t=out:st={max(video_duration - fade, 0.0):.3f}:d={fade:.3f}")
+    result = _run([
+        ffmpeg_exe(), "-hide_banner", "-v", "error", "-y",
+        "-i", video_path, "-i", audio_path,
+        "-map", "0:v:0", "-map", "1:a:0",
+        "-c:v", "copy",
+        "-af", ",".join(filters),
+        "-c:a", "aac", "-b:a", AAC_BITRATE, "-ar", "48000", "-ac", "2",
+        "-t", f"{video_duration:.6f}",
+        "-movflags", "+faststart",
+        output_path,
+    ])
+    if result.returncode != 0 or not os.path.isfile(output_path) or os.path.getsize(output_path) == 0:
+        raise AudioError(f"ffmpeg could not add the soundtrack: {_tail(result.stderr)}")
+
+
+def attach_soundtrack(silent_path, final_path, audio_path, video_duration, fade_out, audio_duration=None):
+    """Muxes the soundtrack into final_path. On failure the silent render is kept as final_path.
+
+    Returns (added, message).
+    """
+    try:
+        mux_soundtrack(silent_path, audio_path, final_path, video_duration, fade_out, audio_duration)
+    except Exception as err:
+        if os.path.exists(final_path):
+            os.remove(final_path)
+        os.replace(silent_path, final_path)
+        return False, f"The video was saved without sound: {err}"
+    os.remove(silent_path)
+    return True, f"Soundtrack added ({os.path.basename(audio_path)})."
