+        paths = ["x/img10.png", "x/img2.png", "x/IMG1.png"]
+        self.assertEqual(seq.order_images(paths), ["x/IMG1.png", "x/img2.png", "x/img10.png"])
+        self.assertEqual(seq.order_images(paths, reverse=True), ["x/img10.png", "x/img2.png", "x/IMG1.png"])
+        self.assertEqual(seq.order_images(paths, sort_by_name=False), paths)
+
+    def test_gallery_captions(self):
+        items = seq.gallery_items(["a/01.webp", "a/02.webp", "a/03.webp"])
+        self.assertEqual([caption for _, caption in items],
