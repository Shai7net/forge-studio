+import math
+import os
+import sys
+import unittest
+
+import numpy as np
+from PIL import Image
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from iz_helpers.image import shrink_and_paste_on_blank  # noqa: E402
+from iz_helpers.zoom_frames import (  # noqa: E402
+    FrameRequest,
+    classic_requests,
+    render_request,
+    requests_from_positions,
+)
+
+
+def original_all_frames(main_frames, width, height, mask_width, mask_height, num_interpol_frames):
+    """Verbatim copy of the interpolation loop in create_zoom_single before the update
+    (upscale and collect calls removed; they do not change the frames)."""
+    all_frames = []
+    current_image = main_frames[0]
+    all_frames.append(main_frames[0])
+    for i in range(len(main_frames) - 1):
+        # interpolation steps between 2 inpainted images (=sequential zoom and crop)
+        for j in range(num_interpol_frames - 1):
+            current_image = main_frames[i + 1]
+            interpol_image = current_image
+
+            interpol_width = math.ceil(
+                (
+                    1
+                    - (1 - 2 * mask_width / width)
+                    ** (1 - (j + 1) / num_interpol_frames)
+                )
+                * width
+                / 2
+            )
+
+            interpol_height = math.ceil(
+                (
+                    1
+                    - (1 - 2 * mask_height / height)
+                    ** (1 - (j + 1) / num_interpol_frames)
+                )
+                * height
+                / 2
+            )
+
+            interpol_image = interpol_image.crop(
+                (
+                    interpol_width,
+                    interpol_height,
+                    width - interpol_width,
+                    height - interpol_height,
+                )
+            )
+
+            interpol_image = interpol_image.resize((width, height))
+
+            # paste the higher resolution previous image in the middle to avoid drop in quality caused by zooming
+            interpol_width2 = math.ceil(
+                (1 - (width - 2 * mask_width) / (width - 2 * interpol_width))
+                / 2
+                * width
+            )
+
+            interpol_height2 = math.ceil(
+                (1 - (height - 2 * mask_height) / (height - 2 * interpol_height))
+                / 2
+                * height
+            )
+
+            prev_image_fix_crop = shrink_and_paste_on_blank(
+                main_frames[i], interpol_width2, interpol_height2
+            )
+
+            interpol_image.paste(prev_image_fix_crop, mask=prev_image_fix_crop)
+
+            all_frames.append(interpol_image)
+
+        all_frames.append(current_image)
+    return all_frames
+
+
+def random_frames(count, width, height, seed):
+    rng = np.random.default_rng(seed)
+    return [Image.fromarray(rng.integers(0, 256, size=(height, width, 3), dtype=np.uint8), "RGB")
+            for _ in range(count)]
+
+
+class GoldenInterpolationTest(unittest.TestCase):
+    def test_classic_requests_reproduce_original_frames(self):
+        cases = [((512, 512), 2), ((512, 512), 5), ((1024, 576), 5), ((576, 1024), 2), ((512, 288), 30)]
+        for (width, height), n in cases:
+            with self.subTest(size=(width, height), n=n):
+                main_frames = random_frames(4, width, height, seed=width + n)
+                mask_width, mask_height = math.trunc(width / 4), math.trunc(height / 4)
+                expected = original_all_frames(main_frames, width, height, mask_width, mask_height, n)
+                requests = classic_requests(len(main_frames), n)
+                self.assertEqual(len(requests), len(expected))
+                for index, request in enumerate(requests):
+                    actual = render_request(main_frames, request, width, height, mask_width, mask_height)
+                    self.assertEqual(actual.size, expected[index].size)
+                    self.assertTrue(
+                        np.array_equal(np.array(actual), np.array(expected[index])),
+                        f"frame {index} differs ({request})",
+                    )
+
+    def test_single_frame_per_step_uses_the_next_main_frame(self):
+        main_frames = random_frames(3, 64, 64, seed=1)
+        frames = [render_request(main_frames, r, 64, 64, 16, 16) for r in classic_requests(3, 1)]
+        self.assertEqual([id(f) for f in frames], [id(f) for f in main_frames])
+
+    def test_collect_names_match_original(self):
+        names = []
+        main_frames = random_frames(2, 64, 64, seed=2)
+        request = classic_requests(2, 3)[1]
+        render_request(main_frames, request, 64, 64, 16, 16, collect=lambda image, name: names.append(name))
+        self.assertEqual(names, ["interpol_img_0_0].png", "interpol_resize_0_0.png", "interpol_prevcrop_0_0.png"])
+
+
+class FeatherTest(unittest.TestCase):
+    @staticmethod
+    def mixed_pixels(feather):
+        inner = Image.new("RGB", (256, 256), (0, 0, 255))
+        outer = Image.new("RGB", (256, 256), (255, 0, 0))
+        frame = render_request([inner, outer], FrameRequest(0, 0.5), 256, 256, 64, 64, feather=feather)
+        row = np.array(frame)[128]
+        red, blue = row[:, 0], row[:, 2]
+        return int(np.sum((red > 20) & (red < 235) & (blue > 20) & (blue < 235)))
+
+    def test_feather_softens_the_pasted_edge_only_when_asked(self):
+        self.assertLessEqual(self.mixed_pixels(0), 2)
+        self.assertGreaterEqual(self.mixed_pixels(8), 6)
+
+
+class PositionRequestTest(unittest.TestCase):
+    def test_positions_to_requests(self):
+        requests = requests_from_positions([0, 0.5, 1.0, 1.9999999, 2.25, 9.0], main_frame_count=4)
+        self.assertEqual(requests[0], FrameRequest(0, 0.0))
+        self.assertEqual(requests[1].step, 0)
+        self.assertAlmostEqual(requests[1].fraction, 0.5)
+        self.assertEqual(requests[2], FrameRequest(1, 0.0))
+        self.assertEqual(requests[3], FrameRequest(2, 0.0))
+        self.assertEqual(requests[4].step, 2)
+        self.assertAlmostEqual(requests[4].fraction, 0.25)
+        self.assertEqual(requests[5], FrameRequest(3, 0.0))
+
+    def test_uniform_positions_match_classic_frames(self):
+        main_frames = random_frames(3, 128, 128, seed=3)
+        n = 4
+        positions = [k / n for k in range(2 * n + 1)]
+        by_position = [render_request(main_frames, r, 128, 128, 32, 32)
+                       for r in requests_from_positions(positions, 3)]
+        classic = [render_request(main_frames, r, 128, 128, 32, 32) for r in classic_requests(3, n)]
+        for a, b in zip(by_position, classic):
+            self.assertTrue(np.array_equal(np.array(a), np.array(b)))
+
+
+if __name__ == "__main__":
+    unittest.main()
