+        for x, colour in expected.items():
+            with self.subTest(x=x):
+                self.assertEqual(mask.getpixel((x, 256)), colour)
+        self.assertEqual(mask.getpixel((0, 0)), black)
+        self.assertEqual(seq.seam_band_size(128, 128, 0.01), 2)
+
