+class JsCompatibilityTest(unittest.TestCase):
+    def test_to_fixed_rounding(self):
+        self.assertEqual(kf.format_value(1.125), "1.13")
+        self.assertEqual(kf.format_value(-1.125), "-1.13")
+        self.assertEqual(kf.format_value(1.005), "1.00")
+        self.assertEqual(kf.format_value(0.005), "0.01")
+        self.assertEqual(kf.format_value(2), "2.00")
+
+    def test_disco_format(self):
+        self.assertEqual(kf.format_disco([1, 1.5, 2]), "0: (1.00), 1: (1.50), 2: (2.00)")
+
+    @staticmethod
+    def js_filter_data(left, right, sample_rate, fps):
+        """Line-by-line port of the website's filterData arithmetic (Float32Array stores round to float32)."""
+        raw = [float(np.float32(abs(float(a)) + abs(float(b)))) for a, b in zip(left, right)]
+        raw = [float(np.float32(x / 2)) for x in raw]
+        samples = (len(raw) / sample_rate) * fps
+        block = math.floor(len(raw) / samples)
+        result = []
+        i = 0
+        while i < samples:
+            chunk = raw[i * block:(i + 1) * block - 1]
+            total = 0.0
+            for value in chunk:
+                total = total + value
+            result.append(total / len(chunk) if chunk else math.nan)
+            i += 1
+        return result
+
+    def test_loudness_matches_website_arithmetic(self):
+        rng = np.random.default_rng(7)
+        pcm = rng.uniform(-1, 1, size=(1009, 2)).astype(np.float32)
+        for fps in (12, 12.5, 30):
+            with self.subTest(fps=fps):
+                expected = self.js_filter_data(pcm[:, 0], pcm[:, 1], 97, fps)
+                actual = kf.generator_loudness(pcm, 97, fps)
+                np.testing.assert_array_equal(actual, np.array(expected))
+
+    def test_generate_constant_and_silence(self):
+        loud = np.full((4800, 2), 0.5, dtype=np.float32)
+        text, values = kf.generate_keyframes(loud, 4800, 4)
+        self.assertEqual(text, "0: (2.00), 1: (2.00), 2: (2.00), 3: (2.00)")
+        text, values = kf.generate_keyframes(np.zeros((4800, 2), dtype=np.float32), 4800, 2)
+        self.assertEqual(text, "0: (1.00), 1: (1.00)")
+
+
+if __name__ == "__main__":
+    unittest.main()
