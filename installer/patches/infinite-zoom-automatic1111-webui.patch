+class GeometryTest(unittest.TestCase):
+    def test_zoom_factor_two_matches_classic_mask(self):
+        for width, height in [(512, 512), (1024, 576), (576, 1024), (1000, 600)]:
+            with self.subTest(size=(width, height)):
+                self.assertEqual(seq.zoom_mask_size(width, height, 2.0),
+                                 (math.trunc(width / 4), math.trunc(height / 4)))
+        self.assertEqual(seq.zoom_mask_size(1024, 1024, 1.3333), (127, 127))
+
+    def test_output_size_for(self):
+        self.assertEqual(seq.output_size_for((1456, 816)), (1456, 816))
+        self.assertEqual(seq.output_size_for((1010, 700)), (1008, 704))
+        self.assertEqual(seq.output_size_for((4000, 100)), (2048, 96))
+
+    def test_fit_image_center_crops(self):
+        image = Image.new("RGB", (800, 400), "red")
+        image.paste(Image.new("RGB", (400, 400), "blue"), (200, 0))
+        fitted = seq.fit_image(image, 256, 256)
+        self.assertEqual(fitted.size, (256, 256))
+        self.assertEqual(fitted.getpixel((128, 128)), (0, 0, 255))
+
+    def test_compose_layer_puts_previous_frame_in_center(self):
+        outer = Image.new("RGB", (512, 512), (255, 0, 0))
+        inner = Image.new("RGB", (512, 512), (0, 0, 255))
+        composed = seq.compose_layer(outer, inner, 128, 128)
+        self.assertEqual(composed.getpixel((128, 128)), (0, 0, 255))
+        self.assertEqual(composed.getpixel((383, 383)), (0, 0, 255))
+        self.assertEqual(composed.getpixel((127, 127)), (255, 0, 0))
+        self.assertEqual(composed.getpixel((384, 256)), (255, 0, 0))
+        self.assertEqual(outer.getpixel((256, 256)), (255, 0, 0), "outer image must not be modified")
+
+    def test_feathered_paste_restores_center_and_fades_edge(self):
+        base = Image.new("RGB", (512, 512), (255, 0, 0))
+        inner = Image.new("RGB", (512, 512), (0, 0, 255))
+        result = seq.feathered_paste(base, inner, 128, 128, feather=16)
+        self.assertEqual(result.getpixel((256, 256)), (0, 0, 255))
+        self.assertEqual(result.getpixel((128 + 20, 256)), (0, 0, 255))
+        self.assertEqual(result.getpixel((128, 256)), (255, 0, 0))
+        red, _, blue = result.getpixel((128 + 8, 256))
+        self.assertTrue(100 < red < 160 and 100 < blue < 160, (red, blue))
+        self.assertEqual(result.getpixel((100, 256)), (255, 0, 0))
+        self.assertEqual(base.getpixel((256, 256)), (255, 0, 0), "base must not be modified")
