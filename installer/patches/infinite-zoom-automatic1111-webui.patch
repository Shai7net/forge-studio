index 0000000..9229a12
--- /dev/null
+++ b/iz_helpers/image_sequence.py
@@ -0,0 +1,123 @@
+"""Uploaded images as the layers of a zoom. Pure (PIL only).
+
+Image 1 is the innermost layer (the start of a zoom-out), the last image the outermost.
+Each layer is the next image with the previous layer shrunk into its center, so a ready-made
+nested sequence (Midjourney Zoom Out, ZoomVideoComposer) zooms without any AI, and unrelated
+images can have the seam around the pasted center repainted.
+"""
+import math
+import os
+import re
+
+import numpy as np
+from PIL import Image, ImageDraw, ImageOps
+
+IMAGE_FILE_TYPES = ["image", ".png", ".jpg", ".jpeg", ".webp", ".bmp", ".tif", ".tiff"]
+SIZE_STEP = 16
+MAX_SIZE = 2048
+
+
+def natural_sort_key(path):
+    name = os.path.basename(path).lower()
+    return [int(part) if part.isdigit() else part for part in re.split(r"(\d+)", name)]
+
+
+def order_images(paths, sort_by_name=True, reverse=False):
+    paths = list(paths)
+    if sort_by_name:
+        paths.sort(key=natural_sort_key)
+    if reverse:
+        paths.reverse()
+    return paths
+
+
+def load_image(path):
+    with Image.open(path) as image:
+        image.load()
+        image = ImageOps.exif_transpose(image)
+        if image.mode in ("RGBA", "LA", "P"):
+            image = image.convert("RGBA")
+            background = Image.new("RGBA", image.size, (0, 0, 0, 255))
+            background.alpha_composite(image)
+            image = background
+        return image.convert("RGB")
+
+
+def fit_image(image, width, height):
+    """Center-crop to the output aspect ratio, then resize."""
+    return ImageOps.fit(image, (width, height), method=Image.LANCZOS, centering=(0.5, 0.5))
+
+
+def output_size_for(image_size):
+    """Output Width/Height slider values closest to an image size."""
+    return tuple(min(MAX_SIZE, max(SIZE_STEP, int(round(v / SIZE_STEP)) * SIZE_STEP)) for v in image_size)
+
+
+def zoom_mask_size(width, height, zoom_factor):
+    """Border sizes that make the inner layer 1/zoom_factor of the frame (2.0 gives the classic width/4)."""
+    return math.trunc(width * (1 - 1 / zoom_factor) / 2), math.trunc(height * (1 - 1 / zoom_factor) / 2)
+
+
+def compose_layer(outer_image, inner_frame, mask_width, mask_height):
+    width, height = outer_image.size
+    composed = outer_image.copy()
+    inner = inner_frame.resize((width - 2 * mask_width, height - 2 * mask_height), resample=Image.LANCZOS)
+    composed.paste(inner, (mask_width, mask_height))
+    return composed
+
+
+def seam_band_size(mask_width, mask_height, seam_fraction):
+    """Width in pixels of the band repainted outside the pasted center."""
+    return max(2, int(round(min(mask_width, mask_height) * seam_fraction)))
+
+
+def seam_mask(width, height, mask_width, mask_height, band, overlap):
+    """White ring from `band` px outside the edge of the pasted center to `overlap` px inside it."""
+    mask = Image.new("L", (width, height), 0)
+    draw = ImageDraw.Draw(mask)
+    draw.rectangle(
+        (
+            max(mask_width - band, 0),
+            max(mask_height - band, 0),
+            min(width - mask_width + band, width) - 1,
+            min(height - mask_height + band, height) - 1,
+        ),
+        fill=255,
+    )
+    inner = (
+        mask_width + overlap,
+        mask_height + overlap,
+        width - mask_width - overlap - 1,
+        height - mask_height - overlap - 1,
+    )
+    if inner[2] > inner[0] and inner[3] > inner[1]:
+        draw.rectangle(inner, fill=0)
+    return mask.convert("RGB")
+
+
+def feathered_paste(base, inner_frame, mask_width, mask_height, feather):
+    """inner_frame shrunk into the center of base, fading in over `feather` px from its edge.
+
+    After img2img this gives the previous frame its sharp pixels back while its edge keeps
+    the repainted continuation, so the seam stays smooth.
+    """
+    width, height = base.size
+    inner_width, inner_height = width - 2 * mask_width, height - 2 * mask_height
+    inner = inner_frame.resize((inner_width, inner_height), resample=Image.LANCZOS)
+    alpha = None
+    if feather > 0:
+        x = np.minimum(np.arange(inner_width), np.arange(inner_width)[::-1])
+        y = np.minimum(np.arange(inner_height), np.arange(inner_height)[::-1])
+        distance = np.minimum.outer(y, x).astype(np.float32)
+        alpha = Image.fromarray((np.clip(distance / feather, 0, 1) * 255).astype(np.uint8), "L")
+    result = base.copy()
+    result.paste(inner, (mask_width, mask_height), alpha)
+    return result
+
+
+def gallery_items(paths):
+    items = []
+    for index, path in enumerate(paths, start=1):
+        role = " (center)" if index == 1 else " (outermost)" if index == len(paths) else ""
+        items.append((path, f"{index}{role}: {os.path.basename(path)}"))
+    return items
diff --git a/iz_helpers/keyframes.py b/iz_helpers/keyframes.py
new file mode 100644
index 0000000..756ad5c
--- /dev/null
+++ b/iz_helpers/keyframes.py
@@ -0,0 +1,455 @@
+"""Keyframe schedules that set the pace of the zoom.
+
+Pure module (numpy + stdlib only), so it can be tested without the webui.
+
+Accepted keyframe text, as produced by the audio keyframe generator
+(https://www.chigozie.co.uk/audio-keyframe-generator/) and by Deforum:
+  * Disco / Deforum: "0: (1.00), 1: (1.53), 12: (1.20)" - sparse keys are interpolated
+  * PyTTI: the generator's lambda string - only its fps and dictionary are read, it is never executed
+  * CSV: one value per line, or "frame,value" rows with an optional header
+  * JSON: [1.0, 1.2, ...], [[0, 1.0], ...] or {"0": 1.0, ...}
+Values must be plain numbers: formulas inside keyframes are rejected, never evaluated.
+"""
+import ast
+import json
+import math
+import re
+from decimal import Decimal, ROUND_HALF_UP
+
+import numpy as np
+
+MODE_SPEED = "Speed multiplier"
+MODE_DEFORUM = "Deforum zoom"
+KEYFRAME_MODES = [MODE_SPEED, MODE_DEFORUM]
+
+MAX_KEYFRAMES = 250_000
+COMMON_FPS = (8, 10, 12, 15, 24, 25, 30, 48, 50, 60)
+GENERATOR_DEFAULT_FUNCTION = "1 + x^4"
+
+_NUMBER = r"[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?"
+_NUMBER_ONLY = re.compile(r"^" + _NUMBER + r"$")
+_DISCO_PAIR = re.compile(
+    r"[\"']?(\d+)[\"']?\s*:\s*(?:\(\s*(" + _NUMBER + r")\s*\)|(" + _NUMBER + r"))"
+)
+# the generator's PyTTI output ends with: ..., <fps>, {0: (1.00), 1: (1.53)})
+_PYTTI_TAIL = re.compile(r",\s*(" + _NUMBER + r")\s*,\s*\{([^{}]*)\}\s*\)\s*$", re.S)
+
+
+class KeyframeError(ValueError):
+    pass
+
+
+class Keyframes:
+    """Sorted (frame, value) keyframes and the format they were read from."""
+
+    def __init__(self, points, fmt, fps=None):
+        self.points = points
+        self.format = fmt
+        self.fps = fps
+
+    @property
+    def frame_count(self):
+        return self.points[-1][0] + 1
+
+    def dense(self):
+        """One value per keyframe frame. Values between keys are linear, the first value holds before it."""
+        frames = np.array([p[0] for p in self.points], dtype=np.float64)
+        values = np.array([p[1] for p in self.points], dtype=np.float64)
+        return np.interp(np.arange(self.frame_count, dtype=np.float64), frames, values)
+
+
+def parse_keyframes(text):
+    if text is None or not str(text).strip():
+        raise KeyframeError("The keyframes are empty.")
+    text = str(text).lstrip("﻿").strip()
+
+    if "lambda" in text:
+        tail = _PYTTI_TAIL.search(text)
+        if tail:
+            return _finish(_disco_points(tail.group(2)), "PyTTI", fps=float(tail.group(1)))
+
+    if text[0] in "[{":
+        try:
+            data = json.loads(text)
+        except ValueError:
+            data = None
+        if data is not None:
+            return _finish(_json_points(data), "JSON")
+
+    if ":" in text:
+        return _finish(_disco_points(text), "Disco/Deforum")
+    return _finish(_csv_points(text), "CSV")
+
+
+def _disco_points(text):
+    points = []
+    for match in _DISCO_PAIR.finditer(text):
+        value = match.group(2) if match.group(2) is not None else match.group(3)
+        points.append((int(match.group(1)), float(value)))
+    leftover = re.sub(r"[\s,;{}]", "", _DISCO_PAIR.sub("", text))
+    if leftover:
+        raise KeyframeError(
+            "Keyframes must be plain numbers such as '0: (1.00), 1: (1.25)'. "
+            f"Could not read: {leftover[:40]!r} (formulas are not evaluated)."
+        )
+    return points
+
+
+def _frame_number(value):
+    number = float(value)
+    if not number.is_integer():
+        raise KeyframeError(f"Frame numbers must be whole numbers, got {value!r}.")
+    return int(number)
+
+
+def _csv_points(text):
+    rows = []
+    for line in text.splitlines():
+        fields = [f.strip() for f in re.split(r"[,;\t]", line) if f.strip()]
+        if fields:
+            rows.append(fields)
+    if rows and not all(_NUMBER_ONLY.match(f) for f in rows[0]):
+        rows = rows[1:]  # header row, e.g. "frame,value"
+
+    points = []
+    for index, fields in enumerate(rows):
+        if not all(_NUMBER_ONLY.match(f) for f in fields):
+            raise KeyframeError(f"CSV row {index + 1} is not numeric: {', '.join(fields)[:40]!r}.")
+        if len(fields) == 1:
+            points.append((index, float(fields[0])))
+        elif len(fields) == 2:
+            points.append((_frame_number(fields[0]), float(fields[1])))
+        else:
+            raise KeyframeError("CSV keyframes need one column (value) or two columns (frame,value).")
+    return points
+
+
+def _json_points(data):
+    try:
+        if isinstance(data, dict):
+            return [(_frame_number(k), float(v)) for k, v in data.items()]
+        if isinstance(data, list):
+            points = []
+            for index, item in enumerate(data):
+                if isinstance(item, (int, float)) and not isinstance(item, bool):
+                    points.append((index, float(item)))
+                elif isinstance(item, (list, tuple)) and len(item) == 2:
+                    points.append((_frame_number(item[0]), float(item[1])))
+                elif isinstance(item, dict) and "frame" in item and "value" in item:
+                    points.append((_frame_number(item["frame"]), float(item["value"])))
+                else:
+                    raise KeyframeError(f"JSON keyframe {index} is not a number or a [frame, value] pair.")
+            return points
+    except (TypeError, ValueError) as err:
+        if isinstance(err, KeyframeError):
+            raise
+        raise KeyframeError("JSON keyframes must contain numbers only.") from None
+    raise KeyframeError("JSON keyframes must be a list or an object.")
+
+
+def _finish(points, fmt, fps=None):
+    if not points:
+        raise KeyframeError("No keyframes found. Paste the text from the keyframe generator (Disco, PyTTI or CSV).")
+    if len(points) > MAX_KEYFRAMES:
+        raise KeyframeError(f"Too many keyframes ({len(points):,}); the limit is {MAX_KEYFRAMES:,}.")
+    seen = set()
+    for frame, value in points:
+        if frame < 0:
+            raise KeyframeError(f"Keyframe {frame}: frame numbers cannot be negative.")
+        if not math.isfinite(value):
+            raise KeyframeError(f"Keyframe {frame}: the value is not a finite number.")
+        if frame in seen:
+            raise KeyframeError(f"Keyframe {frame} appears twice.")
+        seen.add(frame)
+    points.sort()
+    if points[-1][0] >= MAX_KEYFRAMES:
+        raise KeyframeError(f"Keyframes go past frame {MAX_KEYFRAMES:,}.")
+    if fps is not None and not 0 < fps <= 1000:
+        raise KeyframeError(f"Invalid fps {fps} inside the PyTTI keyframes.")
+    return Keyframes(points, fmt, fps)
+
+
+def resolve_fps(keyframes, requested_fps, video_fps, audio_duration=None):
+    """Returns (fps, how it was chosen, warning or None)."""
+    if requested_fps and requested_fps > 0:
+        return float(requested_fps), "set manually", None
+    if keyframes.fps:
+        return float(keyframes.fps), "read from the PyTTI keyframes", None
+    if audio_duration and audio_duration > 0:
+        measured = keyframes.frame_count / audio_duration
+        nearest = min(COMMON_FPS, key=lambda f: abs(f - measured))
+        if abs(nearest - measured) <= 0.02 * nearest:
+            return float(nearest), f"detected from the soundtrack length ({measured:.2f} fps)", None
+        return measured, "measured from the soundtrack length", (
+            f"{keyframes.frame_count:,} keyframes over {audio_duration:.1f}s of music is {measured:.2f} fps, "
+            "not a standard rate. Check the soundtrack is the one the keyframes were made from."
+        )
+    return float(video_fps), "assumed equal to the video FPS", (
+        "Keyframes FPS could not be detected, so the video FPS is assumed. If the keyframes were generated "
+        "at another rate (the website default is 12), set Keyframes FPS."
+    )
+
+
+def zoom_positions(values, keyframe_fps, video_fps, zoom_speed, mode=MODE_SPEED, zoom_factor=2.0, frame_count=None):
+    """Zoom position for every output frame of a zoom-out, in outpaint steps (0 = innermost image).
+
+    Each keyframe holds a constant zoom rate for 1/keyframe_fps seconds; positions are the exact
+    integral of that rate at each video frame, so the pace is independent of the two frame rates.
+    """
+    values = np.asarray(values, dtype=np.float64)
+    if values.size == 0:
+        raise KeyframeError("There are no keyframe values.")
+    if keyframe_fps <= 0 or video_fps <= 0:
+        raise KeyframeError("FPS must be positive.")
+    if mode == MODE_DEFORUM:
+        if zoom_factor <= 1:
+            raise KeyframeError("The zoom factor must be above 1.")
+        rates = np.log(np.clip(values, 1e-3, None)) / math.log(zoom_factor)
+    else:
+        if zoom_speed <= 0:
+            raise KeyframeError("Zoom Speed must be positive.")
+        rates = np.clip(values, 0.0, None) / (keyframe_fps * zoom_speed)
+
+    starts = np.concatenate(([0.0], np.cumsum(rates)[:-1]))
+    if frame_count is None:
+        frame_count = max(1, int(round(values.size / keyframe_fps * video_fps)))
+    u = np.arange(frame_count, dtype=np.float64) * (keyframe_fps / video_fps)
+    k = np.minimum(np.floor(u).astype(np.int64), values.size - 1)
+    return starts[k] + (u - k) * rates[k]
+
+
+def playback_positions(forward_positions, zoom_in, max_steps=None):
+    """Positions in playback order and the number of outpaint steps they need."""
+    positions = np.maximum(np.asarray(forward_positions, dtype=np.float64), 0.0)
+    if zoom_in:
+        positions = np.maximum(positions[-1] - positions, 0.0)
+    needed = max(1, int(math.ceil(float(positions.max()) - 1e-6)))
+    if max_steps is not None:
+        positions = np.minimum(positions, float(max_steps))
+    return positions, needed
+
+
+class KeyframePlan:
+    def __init__(self, keyframes, fps, fps_note, warnings, values, positions, steps_needed, video_fps, mode,
+                 scale=1.0, notes=None):
+        self.keyframes = keyframes
+        self.fps = fps
+        self.fps_note = fps_note
+        self.warnings = warnings
+        self.values = values
+        self.positions = positions
+        self.steps_needed = steps_needed
+        self.video_fps = video_fps
+        self.mode = mode
+        self.scale = scale
+        self.notes = notes or []
+
+    @property
+    def frame_count(self):
+        return len(self.positions)
+
+    @property
+    def duration(self):
+        return self.frame_count / self.video_fps
+
+
+def build_plan(text, requested_fps, mode, video_fps, zoom_speed, zoom_in,
+               zoom_factor=2.0, audio_duration=None, max_steps=None):
+    """Zoom positions for every frame. With max_steps (a fixed number of images) the keyframe pace is
+    scaled so the zoom uses exactly those steps over the whole video; the keyframes still decide where
+    it speeds up and slows down, instead of the zoom running out early and holding on one image."""
+    keyframes = parse_keyframes(text)
+    fps, fps_note, warning = resolve_fps(keyframes, requested_fps, video_fps, audio_duration)
+    warnings = [warning] if warning else []
+    notes = []
+    values = keyframes.dense()
+    forward = zoom_positions(values, fps, video_fps, zoom_speed, mode, zoom_factor)
+    reach = float(np.max(forward))
+    scale = 1.0
+    if reach < 1e-6:
+        warnings.append("These keyframes never move the zoom (all speeds are 0 or below).")
+    elif max_steps is not None:
+        scale = max_steps / reach
+        forward = forward * scale
+        notes.append(
+            f"Keyframe pace scaled x{scale:.2f} so the zoom through {max_steps + 1} images fills the whole video."
+        )
+    positions, needed = playback_positions(forward, zoom_in, max_steps)
+    return KeyframePlan(keyframes, fps, fps_note, warnings, values, positions, needed, video_fps, mode,
+                        scale, notes)
+
+
+def _clock(seconds):
+    minutes, rest = divmod(seconds, 60)
+    return f"{int(minutes)}:{rest:04.1f}"
+
+
+def describe_plan(plan, available_steps=None):
+    lines = [
+        f"**Format:** {plan.keyframes.format}, {plan.keyframes.frame_count:,} keyframe frames "
+        f"({len(plan.keyframes.points):,} given)",
+        f"**Keyframes FPS:** {plan.fps:g} ({plan.fps_note})",
+        f"**Length:** {_clock(plan.duration)} = {plan.frame_count:,} video frames at {plan.video_fps:g} fps",
+        f"**Values:** min {plan.values.min():.2f}, mean {plan.values.mean():.2f}, max {plan.values.max():.2f} "
+        f"({plan.mode})",
+    ]
+    if available_steps is None:
+        lines.append(f"**Outpaint steps needed:** {plan.steps_needed}")
+    else:
+        lines.append(
+            f"**Zoom:** through {available_steps + 1} images over the whole video "
+            f"(keyframe pace scaled x{plan.scale:.2f})"
+        )
+    for warning in plan.warnings:
+        lines.append(f"**Warning:** {warning}")
+    return "\n\n".join(lines)
+
+
+# --- keyframe generator (port of the website's filterData) -------------------------------------
+
+_FUNCTIONS = {
+    "sin": (np.sin, 1), "cos": (np.cos, 1), "tan": (np.tan, 1),
+    "asin": (np.arcsin, 1), "acos": (np.arccos, 1), "atan": (np.arctan, 1),
+    "sqrt": (np.sqrt, 1), "abs": (np.abs, 1), "exp": (np.exp, 1),
+    "log10": (np.log10, 1), "log2": (np.log2, 1),
+    "floor": (np.floor, 1), "ceil": (np.ceil, 1), "round": (np.round, 1),
+    "min": (np.minimum, 2), "max": (np.maximum, 2), "pow": (np.power, 2),
+}
+_CONSTANTS = {"pi": math.pi, "e": math.e}
+_VARIABLES = ("x", "y", "t")
+_BINARY = {ast.Add: np.add, ast.Sub: np.subtract, ast.Mult: np.multiply,
+           ast.Div: np.divide, ast.Mod: np.mod, ast.Pow: np.power}
+
+
+def _log(value, base=None):
+    return np.log(value) if base is None else np.log(value) / np.log(base)
+
+
+def _check_node(node):
+    if isinstance(node, ast.Constant):
+        if isinstance(node.value, bool) or not isinstance(node.value, (int, float)):
+            raise KeyframeError(f"Only numbers are allowed, not {node.value!r}.")
+    elif isinstance(node, ast.Name):
+        if node.id not in _VARIABLES and node.id not in _CONSTANTS:
+            raise KeyframeError(f"Unknown name {node.id!r}. Use x (loudness 0..1), y (frame), pi or e.")
+    elif isinstance(node, ast.UnaryOp):
+        if not isinstance(node.op, (ast.UAdd, ast.USub)):
+            raise KeyframeError("Only + and - are allowed before a value.")
+        _check_node(node.operand)
+    elif isinstance(node, ast.BinOp):
+        if type(node.op) not in _BINARY:
+            raise KeyframeError("Allowed operators: + - * / % ^")
+        _check_node(node.left)
+        _check_node(node.right)
+    elif isinstance(node, ast.Call):
+        name = node.func.id if isinstance(node.func, ast.Name) else None
+        if node.keywords or name is None or (name not in _FUNCTIONS and name != "log"):
+            raise KeyframeError(f"Function not allowed. Available: {', '.join(sorted(list(_FUNCTIONS) + ['log']))}.")
+        arity = (1, 2) if name == "log" else (_FUNCTIONS[name][1],)
+        if len(node.args) not in arity:
+            raise KeyframeError(f"{name}() takes {' or '.join(map(str, arity))} argument(s).")
+        for arg in node.args:
+            _check_node(arg)
+    else:
+        raise KeyframeError(f"{type(node).__name__} is not allowed in the function.")
+
+
+def _evaluate_node(node, env):
+    if isinstance(node, ast.Constant):
+        return float(node.value)
+    if isinstance(node, ast.Name):
+        return env[node.id] if node.id in env else _CONSTANTS[node.id]
+    if isinstance(node, ast.UnaryOp):
+        value = _evaluate_node(node.operand, env)
+        return -value if isinstance(node.op, ast.USub) else value
+    if isinstance(node, ast.BinOp):
+        return _BINARY[type(node.op)](_evaluate_node(node.left, env), _evaluate_node(node.right, env))
+    args = [_evaluate_node(arg, env) for arg in node.args]
+    if node.func.id == "log":
+        return _log(*args)
+    return _FUNCTIONS[node.func.id][0](*args)
+
+
+def compile_function(expression):
+    """Compiles a generator function such as '1 + x^4' into f(x, y) over numpy arrays.
+
+    '^' is a power, as on the website. Nothing is passed to eval(): the expression is
+    parsed and every node is checked against a small whitelist.
+    """
+    source = (expression or "").strip()
+    if not source:
+        raise KeyframeError("The function is empty.")
+    if len(source) > 500:
+        raise KeyframeError("The function is too long.")
+    try:
+        tree = ast.parse(source.replace("^", "**"), mode="eval")
+    except SyntaxError as err:
+        raise KeyframeError(f"Invalid function {source!r}: {err.msg}.") from None
+    _check_node(tree.body)
+
+    def evaluate(x, y):
+        x = np.asarray(x, dtype=np.float64)
+        y = np.asarray(y, dtype=np.float64)
+        with np.errstate(all="ignore"):
+            result = _evaluate_node(tree.body, {"x": x, "y": y, "t": y})
+        return np.broadcast_to(np.asarray(result, dtype=np.float64), x.shape).copy()
+
+    return evaluate
+
+
+def generator_loudness(pcm, sample_rate, fps):
+    """Per-frame loudness computed exactly like the website's filterData (before normalising).
+
+    pcm is (samples, channels) float32. Channels are |L| + |R| ... divided by the channel count in
+    float32, frames are blocks of floor(len / (duration * fps)) samples whose last sample is skipped,
+    and each frame is the mean of its block. Mono files use the absolute value (the website forgets it).
+    """
+    pcm = np.asarray(pcm, dtype=np.float32)
+    if pcm.ndim == 1:
+        pcm = pcm[:, None]
+    length, channels = pcm.shape
+    if length == 0:
+        raise KeyframeError("The soundtrack contains no audio samples.")
+    if fps <= 0:
+        raise KeyframeError("FPS must be positive.")
+
+    raw = np.abs(pcm[:, 0])
+    for channel in range(1, channels):
+        raw = np.abs(raw) + np.abs(pcm[:, channel])
+    if channels > 1:
+        raw = raw / np.float32(channels)
+
+    samples = (length / sample_rate) * fps
+    count = int(math.ceil(samples))
+    block = int(math.floor(length / samples))
+    loudness = np.empty(count, dtype=np.float64)
+    for i in range(count):
+        start = i * block
+        end = min((i + 1) * block - 1, length)
+        if end <= start:
+            loudness[i] = math.nan
+        else:
+            loudness[i] = np.cumsum(raw[start:end], dtype=np.float64)[-1] / (end - start)
+    return loudness
+
+
+def format_value(value):
+    """JavaScript toFixed(2): ties round away from zero on the exact binary value."""
+    return str(Decimal(float(value)).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP))
+
+
+def format_disco(values):
+    return ", ".join(f"{i}: ({format_value(v)})" for i, v in enumerate(values))
+
+
+def generate_keyframes(pcm, sample_rate, fps, expression=GENERATOR_DEFAULT_FUNCTION):
+    """Returns (Disco keyframe text, values) for decoded audio, like the website does."""
+    function = compile_function(expression)
+    loudness = np.nan_to_num(generator_loudness(pcm, sample_rate, fps), nan=0.0)
+    peak = float(loudness.max()) if loudness.size else 0.0
+    x = loudness / peak if peak > 0 else np.zeros_like(loudness)
+    values = function(x, np.arange(x.size, dtype=np.float64))
+    finite = np.isfinite(values)
+    if not finite.all():
+        raise KeyframeError(f"The function gives an invalid number at frame {int(np.argmin(finite))}.")
+    return format_disco(values), values
