+        np.testing.assert_allclose(f([1.0], [6]), [3.0])
+        np.testing.assert_allclose(kf.compile_function("max(x, 0.5)")([0.2, 0.9], [0, 0]), [0.5, 0.9])
+        np.testing.assert_allclose(kf.compile_function("log(8, 2) + t")([0], [2]), [5.0])
+        np.testing.assert_allclose(kf.compile_function("-x^2")([3], [0]), [-9.0])
+
+    def test_rejects_code(self):
+        for source in ["__import__('os')", "x.real", "lambda: 1", "(1).__class__", "x if y else 1",
+                       "a + 1", "open('f')", "[x]", "x < 1", "'s'", "exp(x=1)"]:
+            with self.subTest(source=source):
