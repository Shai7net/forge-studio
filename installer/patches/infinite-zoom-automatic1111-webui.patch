index 0000000..7c53335
--- /dev/null
+++ b/iz_helpers/zoom_frames.py
@@ -0,0 +1,116 @@
+"""Frames of the zoom between consecutive main frames. Pure (PIL only).
+
+A frame is requested as (step, fraction): fraction 0 is main frame `step` itself, a fraction in
+(0, 1) zooms out from main frame `step` toward main frame `step + 1`. The classic request list
+reproduces the extension's original interpolation loop exactly; keyframe-driven renders request
+arbitrary positions.
+"""
+import math
+from typing import NamedTuple
+
+import numpy as np
+from PIL import Image
+
+from .image import shrink_and_paste_on_blank
+
+EDGE_EPSILON = 1e-6
+
+
+class FrameRequest(NamedTuple):
+    step: int
+    fraction: float
+    label: tuple = None  # (i, j) of the classic loop, used for "collect" file names
+
+
+def classic_requests(main_frame_count, num_interpol_frames):
+    """The frame order of the original loop: main frame 0, then for every step its
+    interpolation frames j/n (j = 1..n-1) followed by the next main frame."""
+    requests = [FrameRequest(0, 0.0)]
+    for i in range(main_frame_count - 1):
+        for j in range(num_interpol_frames - 1):
+            requests.append(FrameRequest(i, (j + 1) / num_interpol_frames, (i, j)))
+        requests.append(FrameRequest(i + 1, 0.0))
+    return requests
+
+
+def requests_from_positions(positions, main_frame_count):
+    """Requests for zoom positions measured in steps (0 = first main frame)."""
+    last = main_frame_count - 1
+    requests = []
+    for position in positions:
+        position = min(max(float(position), 0.0), float(last))
+        step = min(int(math.floor(position)), last)
+        fraction = position - step
+        if fraction < EDGE_EPSILON:
+            requests.append(FrameRequest(step, 0.0))
+        elif fraction > 1 - EDGE_EPSILON:
+            requests.append(FrameRequest(step + 1, 0.0))
+        else:
+            requests.append(FrameRequest(step, fraction))
+    return requests
+
+
+def _feather_alpha(pasted, left, top, feather):
+    """Fades the opaque center of a shrink_and_paste_on_blank image in over `feather` pixels."""
+    width, height = pasted.size
+    inner_width, inner_height = width - 2 * left, height - 2 * top
+    if inner_width <= 0 or inner_height <= 0 or feather <= 0:
+        return pasted
+    x = np.minimum(np.arange(inner_width), np.arange(inner_width)[::-1])
+    y = np.minimum(np.arange(inner_height), np.arange(inner_height)[::-1])
+    ramp = np.clip(np.minimum.outer(y, x) / feather, 0, 1)
+    alpha = np.array(pasted.getchannel("A"), dtype=np.float32)
+    alpha[top:top + inner_height, left:left + inner_width] *= ramp
+    result = pasted.copy()
+    result.putalpha(Image.fromarray(alpha.astype(np.uint8), "L"))
+    return result
+
+
+def interpolated_frame(inner, outer, fraction, width, height, mask_width, mask_height,
+                       collect=None, label=None, feather=0):
+    """`outer` zoomed in so that `inner` (pasted at full quality) grows toward the full frame.
+
+    Same arithmetic and PIL calls as the original loop, with exponent 1 - fraction. With
+    feather > 0 (pixels of `outer` that fade from `inner` into it), the pasted edge follows that
+    fade instead of being hard; the classic zoom uses 0.
+    """
+    if collect and label:
+        collect(outer, f"interpol_img_{label[0]}_{label[1]}].png")
+
+    interpol_width = math.ceil(
+        (1 - (1 - 2 * mask_width / width) ** (1 - fraction)) * width / 2
+    )
+    interpol_height = math.ceil(
+        (1 - (1 - 2 * mask_height / height) ** (1 - fraction)) * height / 2
+    )
+    image = outer.crop(
+        (interpol_width, interpol_height, width - interpol_width, height - interpol_height)
+    )
+    image = image.resize((width, height))
+    if collect and label:
+        collect(image, f"interpol_resize_{label[0]}_{label[1]}.png")
+
+    # paste the higher resolution previous image in the middle to avoid drop in quality caused by zooming
+    interpol_width2 = math.ceil(
+        (1 - (width - 2 * mask_width) / (width - 2 * interpol_width)) / 2 * width
+    )
+    interpol_height2 = math.ceil(
+        (1 - (height - 2 * mask_height) / (height - 2 * interpol_height)) / 2 * height
+    )
+    prev_image_fix_crop = shrink_and_paste_on_blank(inner, interpol_width2, interpol_height2)
+    if feather > 0:
+        zoom = width / (width - 2 * interpol_width)
+        prev_image_fix_crop = _feather_alpha(prev_image_fix_crop, interpol_width2, interpol_height2, feather * zoom)
+    image.paste(prev_image_fix_crop, mask=prev_image_fix_crop)
+    if collect and label:
+        collect(image, f"interpol_prevcrop_{label[0]}_{label[1]}.png")
+    return image
+
+
+def render_request(main_frames, request, width, height, mask_width, mask_height, collect=None, feather=0):
+    if request.fraction == 0:
+        return main_frames[request.step]
+    return interpolated_frame(
+        main_frames[request.step], main_frames[request.step + 1], request.fraction,
+        width, height, mask_width, mask_height, collect, request.label, feather,
+    )
