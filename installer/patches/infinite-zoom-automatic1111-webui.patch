@@ -0,0 +1,35 @@
+"""Paths of files uploaded through Gradio components. No webui imports."""
+
+
+def upload_path(value):
+    """Local path of one upload.
+
+    Gradio 3 passes a tempfile wrapper (path in .name), Gradio 4 a plain string and API
+    clients sometimes a dict with "path" or "name".
+    """
+    if value is None:
+        return None
+    if isinstance(value, str):
+        return value or None
+    if isinstance(value, dict):
+        return value.get("path") or value.get("name") or None
+    return getattr(value, "name", None) or None
+
+
+def upload_paths(values):
+    if not values:
+        return []
+    if not isinstance(values, (list, tuple)):
+        values = [values]
+    return [path for path in (upload_path(v) for v in values) if path]
+
+
+def read_text_upload(value, limit=16 * 1024 * 1024):
+    path = upload_path(value)
+    if not path:
+        return None
+    with open(path, "rb") as f:
+        data = f.read(limit + 1)
+    if len(data) > limit:
+        raise ValueError("The keyframe file is too large.")
+    return data.decode("utf-8-sig", errors="replace")
