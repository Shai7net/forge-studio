+    def test_seam_mask_is_a_ring_across_the_center_edge(self):
+        # mask 128, band 64 outward, overlap 8 inward: white x in [64, 135] and [376, 447]
+        self.assertEqual(seq.seam_band_size(128, 128, 0.5), 64)
+        mask = seq.seam_mask(512, 512, 128, 128, band=64, overlap=8)
+        self.assertEqual(mask.mode, "RGB")
+        white, black = (255, 255, 255), (0, 0, 0)
+        expected = {63: black, 64: white, 128: white, 135: white, 136: black, 256: black,
