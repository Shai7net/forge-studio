+
+def lcm_without_lora(sampler, *prompts):
+    """True when an LCM sampler is selected and none of the prompts loads any LoRA.
+
+    LCM sampling needs an LCM checkpoint or LoRA; without one, the output turns gray and
+    smeared. Any LoRA tag counts, so distilled LoRAs with other names do not trigger it.
+    """
+    if not sampler or "lcm" not in str(sampler).lower():
+        return False
+    return not any(_LORA_TAG.search(prompt or "") for prompt in prompts)
+
