+import os
+import sys
+import tempfile
+import unittest
+
+import imageio
+import imageio_ffmpeg
+import numpy as np
+from PIL import Image
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from iz_helpers.video import ZoomVideoWriter, unique_video_path, write_video  # noqa: E402
+
+
+def original_write_video(file_path, frames, fps, reversed=True, start_frame_dupe_amount=15, last_frame_dupe_amount=30):
+    """Verbatim copy of write_video before the update."""
+    if reversed == True:
+        frames = frames[::-1]
+
+    # Drop missformed frames
+    frames = [frame for frame in frames if frame.size == frames[0].size]
+
+    # Create an imageio video writer, avoid block size of 512.
+    writer = imageio.get_writer(file_path, fps=fps, macro_block_size=None)
+
+    # Duplicate the start and end frames
+    start_frames = [frames[0]] * start_frame_dupe_amount
+    end_frames = [frames[-1]] * last_frame_dupe_amount
+
+    # Write the duplicated frames to the video writer
+    for frame in start_frames:
+        # Convert PIL image to numpy array
+        np_frame = np.array(frame)
+        writer.append_data(np_frame)
+
+    # Write the frames to the video writer
+    for frame in frames:
+        np_frame = np.array(frame)
+        writer.append_data(np_frame)
+
+    # Write the duplicated frames to the video writer
+    for frame in  end_frames:
+        np_frame = np.array(frame)
+        writer.append_data(np_frame)
+
+    # Close the video writer
+    writer.close()
+
+
+def decoded(path):
+    reader = imageio_ffmpeg.read_frames(path)
+    meta = next(reader)
+    width, height = meta["size"]
+    return [np.frombuffer(data, dtype=np.uint8).reshape(height, width, 3).copy() for data in reader]
+
+
+class WriterTest(unittest.TestCase):
+    def setUp(self):
+        rng = np.random.default_rng(11)
+        self.frames = [Image.fromarray(rng.integers(0, 256, size=(64, 96, 3), dtype=np.uint8)) for _ in range(9)]
+        self.frames.insert(4, Image.new("RGB", (64, 64), "white"))  # misformed frame
+        self.tmp = tempfile.TemporaryDirectory()
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_matches_original_write_video(self):
+        for reverse in (0, 1):
+            for dupes in ((0, 0), (3, 2)):
+                with self.subTest(reverse=reverse, dupes=dupes):
+                    old = os.path.join(self.tmp.name, f"old_{reverse}_{dupes[0]}.mp4")
+                    new = os.path.join(self.tmp.name, f"new_{reverse}_{dupes[0]}.mp4")
+                    original_write_video(old, self.frames, 12, reverse, *dupes)
+                    write_video(new, self.frames, 12, reverse, *dupes)
+                    old_frames, new_frames = decoded(old), decoded(new)
+                    self.assertEqual(len(new_frames), len(old_frames))
+                    for a, b in zip(old_frames, new_frames):
+                        self.assertTrue(np.array_equal(a, b))
+
+    def test_counts_and_duration(self):
+        path = os.path.join(self.tmp.name, "count.mp4")
+        writer = ZoomVideoWriter(path, 12, start_frame_dupe_amount=2, last_frame_dupe_amount=1)
+        for frame in self.frames:
+            writer.append(frame)
+        writer.close()
+        self.assertEqual(writer.frames_dropped, 1)
+        self.assertEqual(writer.frames_written, 9 + 2 + 1)
+        self.assertAlmostEqual(writer.duration, 1.0)
+        self.assertEqual(len(decoded(path)), 12)
+
+
+class UniquePathTest(unittest.TestCase):
+    def test_renders_in_the_same_second_get_distinct_names(self):
+        with tempfile.TemporaryDirectory() as folder:
+            first = unique_video_path(folder, "123")
+            self.assertEqual(os.path.basename(first), "infinite_zoom_123.mp4")
+            open(first, "wb").close()
+            second = unique_video_path(folder, "123")
+            self.assertEqual(os.path.basename(second), "infinite_zoom_123_1.mp4")
+            open(second[:-4] + "_silent.mp4", "wb").close()  # a render still adding its soundtrack
+            self.assertEqual(os.path.basename(unique_video_path(folder, "123")), "infinite_zoom_123_2.mp4")
+            self.assertEqual(os.path.basename(unique_video_path(folder, "124")), "infinite_zoom_124.mp4")
+
