+class TimelineTest(unittest.TestCase):
+    def test_speed_one_is_one_step_per_zoom_speed(self):
+        pos = kf.zoom_positions(np.ones(90), 30, 30, 1.0)
+        np.testing.assert_allclose(pos, np.arange(90) / 30)
+        pos = kf.zoom_positions(np.ones(90), 30, 30, 2.0)
+        np.testing.assert_allclose(pos, np.arange(90) / 60)
+
+    def test_speed_two_and_pause(self):
+        np.testing.assert_allclose(kf.zoom_positions(np.full(30, 2.0), 30, 30, 1.0), 2 * np.arange(30) / 30)
+        self.assertTrue(np.all(kf.zoom_positions(np.zeros(30), 30, 30, 1.0) == 0))
+
+    def test_pace_is_independent_of_frame_rates(self):
+        pos = kf.zoom_positions(np.ones(36), 12, 30, 1.0)  # 3 s of keyframes at 12 fps, video at 30 fps
+        self.assertEqual(len(pos), 90)
+        np.testing.assert_allclose(pos, np.arange(90) / 30)
+
+    def test_piecewise_speeds(self):
+        values = np.concatenate([np.ones(30), np.zeros(30), np.full(30, 2.0)])
+        pos = kf.zoom_positions(values, 30, 30, 1.0)
+        self.assertAlmostEqual(pos[30], 1.0)
+        self.assertAlmostEqual(pos[60], 1.0)
+        self.assertAlmostEqual(pos[89], 1.0 + 29 * 2 / 30)
+
+    def test_deforum_zoom(self):
+        pos = kf.zoom_positions(np.full(60, 2 ** (1 / 30)), 30, 30, 1.0, kf.MODE_DEFORUM, zoom_factor=2.0)
+        self.assertAlmostEqual(pos[30], 1.0)
+        self.assertAlmostEqual(pos[59], 59 / 30)
+
+    def test_playback_zoom_in_and_steps(self):
+        forward = np.arange(91) / 30
+        out_pos, steps = kf.playback_positions(forward, zoom_in=False)
+        self.assertEqual(steps, 3)
+        in_pos, steps = kf.playback_positions(forward, zoom_in=True)
+        self.assertEqual(steps, 3)
+        self.assertAlmostEqual(in_pos[0], 3.0)
+        self.assertAlmostEqual(in_pos[-1], 0.0)
+
+    def test_max_steps_clamps(self):
+        pos, needed = kf.playback_positions(np.arange(91) / 30, zoom_in=False, max_steps=2)
+        self.assertEqual(needed, 3)
+        self.assertEqual(pos.max(), 2.0)
+
+    def test_plan_and_description(self):
+        text = ", ".join(f"{i}: (1.00)" for i in range(24))
+        plan = kf.build_plan(text, 12, kf.MODE_SPEED, 30, 0.5, zoom_in=False)
+        self.assertEqual(plan.frame_count, 60)
+        self.assertEqual(plan.steps_needed, 4)
+        description = kf.describe_plan(plan)
+        self.assertIn("Outpaint steps needed:** 4", description)
+        img_plan = kf.build_plan(text, 12, kf.MODE_SPEED, 30, 0.5, zoom_in=False, max_steps=2)
+        self.assertIn("through 3 images over the whole video", kf.describe_plan(img_plan, available_steps=2))
+
+    def test_images_fill_the_whole_video(self):
+        # keyframes worth ~4 steps, but only 2 image steps: the pace is scaled instead of holding still
+        text = ", ".join(f"{i}: (1.00)" for i in range(24))
+        out_plan = kf.build_plan(text, 12, kf.MODE_SPEED, 30, 0.5, zoom_in=False, max_steps=2)
+        self.assertEqual(out_plan.steps_needed, 2)
+        self.assertEqual(out_plan.warnings, [])
+        self.assertIn("pace scaled", out_plan.notes[0])
+        self.assertAlmostEqual(out_plan.positions[-1], 2.0)
+        self.assertTrue(np.all(np.diff(out_plan.positions) > 0), "the zoom must never stand still")
+
+        in_plan = kf.build_plan(text, 12, kf.MODE_SPEED, 30, 0.5, zoom_in=True, max_steps=2)
+        self.assertAlmostEqual(in_plan.positions[0], 2.0)
+        self.assertAlmostEqual(in_plan.positions[-1], 0.0)
+        self.assertLess(in_plan.positions[1], in_plan.positions[0], "zoom-in must start moving at once")
+
+    def test_scaled_pace_still_follows_the_keyframes(self):
+        text = ", ".join(f"{i}: ({1 if i < 12 else 3})" for i in range(24))
+        plan = kf.build_plan(text, 12, kf.MODE_SPEED, 30, 1.0, zoom_in=False, max_steps=4)
+        first_second = plan.positions[29] - plan.positions[0]
+        second_second = plan.positions[59] - plan.positions[30]
+        self.assertAlmostEqual(second_second / first_second, 3.0, delta=0.15)
+
