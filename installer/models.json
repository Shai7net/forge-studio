{
  "about": "Forge Studio's model catalog. Paths are relative to forge/webui. The downloader checks each file's size (and sha256 when the server gives it) and resumes broken downloads. 'gated' files need a Hugging Face account that accepted the model's license, and a token (HF_TOKEN or --hf-token).",
  "hf": "https://huggingface.co/",
  "groups": [
    {"id": "required", "title": "LCM LoRAs (SD 1.5 + SDXL) and the 360 panorama LoRA", "always": true,
     "why": "Fast 4-8 step drawing (the LCM styles, AnimateDiff and Deforum workflows use them) and 360 panoramas."},
    {"id": "sd15", "title": "SD 1.5 checkpoints: DreamShaper 8 + its inpainting model + VAE",
     "why": "The model family AnimateDiff, Deforum, Infinite Zoom and most ControlNets work with."},
    {"id": "sdxl", "title": "SDXL checkpoint: Juggernaut XL v9 + SDXL VAE (fp16 fix)",
     "why": "Higher-resolution pictures; Deforum works with SDXL too."},
    {"id": "animatediff", "title": "AnimateDiff motion modules: AnimateLCM + v3 (SD 1.5)",
     "why": "Video from SD 1.5 in txt2img/img2img. AnimateLCM is the fast one (LCM sampler, 8 steps)."},
    {"id": "animatediff_more", "title": "More AnimateDiff: v2, SDXL beta, SparseCtrl RGB + scribble",
     "why": "Older motion styles, SDXL motion, and keyframe control."},
    {"id": "controlnet", "title": "ControlNet SD 1.5 essentials (fp16) + QR Monster v2 + IP-Adapter Plus",
     "why": "Canny, depth, openpose, tile, lineart, softedge, scribble, inpaint; QR Monster for silhouettes and dance; IP-Adapter for a face or style from a picture."},
    {"id": "controlnet_more", "title": "ControlNet SD 1.5 extra (fp16): mlsd, normal, seg, shuffle, ip2p, lineart anime",
     "why": "The rest of the ControlNet 1.1 family."},
    {"id": "controlnet_sdxl", "title": "ControlNet SDXL: xinsir Union ProMax (one model, many controls)",
     "why": "Canny, depth, pose and more for SDXL in one file."},
    {"id": "upscalers", "title": "Upscalers: Real-ESRGAN x2, x4 and x4 anime",
     "why": "Used by Extras, Video Studio, Deforum and Time Strata."},
    {"id": "writer", "title": "Prompt writer (Hebrew/any language -> model-ready English): Gemma 4 E4B",
     "why": "The globe button in the prompt boxes. Runs with llama.cpp (the installer fetches it)."},
    {"id": "video", "title": "Video Studio: Wan 2.2 14B image-to-video (4 steps, Q3) + text encoder + VAE",
     "why": "Text/image/first+last-frame/multi-picture video on 8 GB cards."},
    {"id": "video_replace", "title": "Video Studio: Replace a character (Wan 2.2 Animate) + SAM 2.1 + DWPose",
     "why": "Swap a person in a video with a picture of someone else."},
    {"id": "fibo", "title": "FIBO 2.0 (Bria): Edit Turbo + Dev, int8 + its runtime (non-commercial license)",
     "why": "Top open model for editing pictures by instruction, up to four references."},
    {"id": "flux3", "title": "FLUX 3 Image Klein int8 (gated: accept the license on Hugging Face first)",
     "why": "Black Forest Labs' newest model; 25 s for 1024x1024 on 8 GB."},
    {"id": "segment", "title": "Segment Anything (SAM ViT-B) for Replacer and masks",
     "why": "Click-to-mask in Replacer / Segment Anything."}
  ],
  "presets": {
    "minimal": ["required"],
    "recommended": ["required", "sd15", "animatediff", "controlnet", "upscalers", "writer"],
    "video": ["required", "sd15", "animatediff", "controlnet", "upscalers", "writer", "video", "video_replace"],
    "all": ["required", "sd15", "sdxl", "animatediff", "animatediff_more", "controlnet", "controlnet_more",
            "controlnet_sdxl", "upscalers", "writer", "video", "video_replace", "fibo", "flux3", "segment"]
  },
