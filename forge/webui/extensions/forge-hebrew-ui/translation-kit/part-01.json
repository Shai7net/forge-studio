 "direction": "ltr",
 "instructions": [
  "This file is one part of the interface of Forge Studio, an AI image and video app (Stable Diffusion WebUI Forge).",
  "Translate every value in \"texts\" (and in \"blocks\", when there is one) into the language you were asked for. Never change a key: the program finds each text by its English key.",
  "Fill in \"language\" with the language's own name (for example \"Español\"), \"code\" with its short code (for example \"es\" or \"pt-br\"), and set \"direction\" to \"rtl\" for a language written right to left.",
  "Keep exactly as they are: {0}, {name} and other words in curly braces, %s, ${...}, HTML tags and their attributes, emoji, \\n line breaks, numbers and units, keyboard keys, file names and paths, and code.",
  "Keep the names of models, samplers, programs and formats in English (FLUX, SDXL, SD 1.5, LoRA, ControlNet, AnimateDiff, Deforum, Wan, VAE, CFG, Euler a, LCM, Hires. fix, PNG, MP4...). For a technical term the user will meet in English tutorials, add the English in brackets once, for example \"Escala CFG (CFG Scale)\".",
  "Short labels stay short: they are buttons, tabs and field names. Use the plain, friendly words a video editor or a photo app uses in that language.",
  "A value that should stay in English may stay unchanged.",
  "Return the complete file as valid JSON with the same structure and nothing before or after it."
 ],
 "texts": {
  "run from a list of setting .txt files. Upload them to the box on the right (visible when enabled)": "run from a list of setting .txt files. Upload them to the box on the right (visible when enabled)",
  "(models in subdirectories like photo/sd15.ckpt will be listed as just sd15.ckpt)": "(models in subdirectories like photo/sd15.ckpt will be listed as just sd15.ckpt)",
  "Allow http:// and https:// URLs for input images in API": "Allow http:// and https:// URLs for input images in API",
  "Disable memmapping for loading .safetensors files.": "Disable memmapping for loading .safetensors files.",
  "Write prompts to file: Create a new .txt file for every batch containing the prompt template as well as the generated prompts.": "Write prompts to file: Create a new .txt file for every batch containing the prompt template as well as the generated prompts.",
  "Move/Copy/Delete matching .txt files": "Move/Copy/Delete matching .txt files",
  "Scan Exif-/.txt-data (initially slower, but required for many features to work)": "Scan Exif-/.txt-data (initially slower, but required for many features to work)",
  "Writing videos has  dependency to an existing FFPROBE executable on your machine. D/L here (https://github.com/BtbN/FFmpeg-Builds/releases) your OS variant and point to your installation path": "Writing videos has  dependency to an existing FFPROBE executable on your machine. D/L here (https://github.com/BtbN/FFmpeg-Builds/releases) your OS variant and point to your installation path",
  "Name of your desired inpaint model (img2img-inpaint). Default is vanilla sd-v1-5-inpainting.ckpt": "Name of your desired inpaint model (img2img-inpaint). Default is vanilla sd-v1-5-inpainting.ckpt",
  "Complete documentation is available at https://github.com/adieyal/sd-dynamic-prompts. Please report any issues on GitHub.": "Complete documentation is available at https://github.com/adieyal/sd-dynamic-prompts. Please report any issues on GitHub.",
  "Keyframe values such as 0: (1.00), 1: (1.53). Leave empty for the classic steady zoom": "Keyframe values such as 0: (1.00), 1: (1.53). Leave empty for the classic steady zoom",
